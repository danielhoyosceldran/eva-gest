<Window x:Class="EvaGest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:EvaGest.Resources"
        xmlns:vm="clr-namespace:EvaGest.ViewModels"
        xmlns:pv="clr-namespace:EvaGest.ViewModels.Pages"
        xmlns:v="clr-namespace:EvaGest.Views.Pages"
        Title="EvaGest" Height="720" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type pv:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:AgendaViewModel}"><v:AgendaView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:ClientsViewModel}"><v:ClientsView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:WorkersViewModel}"><v:WorkersView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:CatalogViewModel}"><v:CatalogView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:SalesViewModel}"><v:SalesView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:TillViewModel}"><v:TillView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type pv:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource NavyBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Pale stripe -->
                <RowDefinition Height="Auto" /> <!-- Shop name -->
                <RowDefinition Height="*" />    <!-- Navigation -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PaleInterval}" />

            <TextBlock Grid.Row="1" Text="EvaGest" Foreground="{StaticResource NavTextActiveBrush}"
                       FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                       Margin="20,16,20,16" />

            <StackPanel Grid.Row="2">
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavHome}"
                             IsChecked="True" Command="{Binding NavigateHomeCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavAgenda}"
                             Command="{Binding NavigateAgendaCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavClients}"
                             Command="{Binding NavigateClientsCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavWorkers}"
                             Command="{Binding NavigateWorkersCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavCatalog}"
                             Command="{Binding NavigateCatalogCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavSales}"
                             Command="{Binding NavigateSalesCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavTill}"
                             Command="{Binding NavigateTillCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavReports}"
                             Command="{Binding NavigateReportsCommand}" />
                <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav" Content="{x:Static t:Texts.NavSettings}"
                             Command="{Binding NavigateSettingsCommand}" />
                <Button Style="{StaticResource NavActionItem}" Content="{x:Static t:Texts.NavHelp}"
                        Command="{Binding OpenHelpCommand}" />
            </StackPanel>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Overdue appointments warning -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Stays up no matter which page is open, until every cite past the hour
                 mark is closed (pantalles 1) -->
            <Border Grid.Row="0" Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="0,0,0,1" Padding="16,10"
                    Visibility="{Binding OverdueAppointmentsNotice, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding OverdueAppointmentsNotice}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
