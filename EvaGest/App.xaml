<Application x:Class="EvaGest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EvaGest"
             xmlns:h="clr-namespace:EvaGest.Helpers"
             xmlns:dvm="clr-namespace:EvaGest.ViewModels.Dialogs"
             xmlns:dv="clr-namespace:EvaGest.Views.Dialogs"
             xmlns:evm="clr-namespace:EvaGest.ViewModels.Elements"
             xmlns:ev="clr-namespace:EvaGest.Views.Elements">
    <!-- StartupUri removed on purpose: OnStartup creates the window after the
         database is ready, so the UI never binds to an unmigrated database -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Metrics.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
                <ResourceDictionary Source="Resources/Grid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <h:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <h:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <h:ClosedToOpacityConverter x:Key="ClosedToOpacityConverter" />
            <h:EditModeToVisibilityConverter x:Key="EditModeToVisibilityConverter" />
            <h:InverseVisibilityConverter x:Key="InverseVisibilityConverter" />
            <h:CustomToEnabledConverter x:Key="CustomToEnabledConverter" />
            <h:BackupTypeConverter x:Key="BackupTypeConverter" />
            <h:BytesToSizeConverter x:Key="BytesToSizeConverter" />
            <h:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
            <h:ZeroToVisibilityInverseConverter x:Key="ZeroToVisibilityInverseConverter" />
            <h:PendingToVisibilityConverter x:Key="PendingToVisibilityConverter" />
            <h:PendingToVisibilityInverseConverter x:Key="PendingToVisibilityInverseConverter" />
            <h:DateOnlyConverter x:Key="DateOnlyConverter" />
            <h:LabelConverter x:Key="LabelConverter" />

            <!-- Dialog content templates: DialogWindow only knows DialogViewModelBase,
                 the actual dialog layout is resolved from the ViewModel's runtime type. -->
            <DataTemplate DataType="{x:Type dvm:ServiceDialogViewModel}"><dv:ServiceDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:ProductDialogViewModel}"><dv:ProductDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:PaymentMethodDialogViewModel}"><dv:PaymentMethodDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:CategoryDialogViewModel}"><dv:CategoryDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:ClientDialogViewModel}"><dv:ClientDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:ClientRecordViewModel}"><dv:ClientRecordView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:AppointmentDialogViewModel}"><dv:AppointmentDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:SaleDialogViewModel}"><dv:SaleDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:MovementDialogViewModel}"><dv:MovementDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:ExportDialogViewModel}"><dv:ExportDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:RestoreDialogViewModel}"><dv:RestoreDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:HelpViewModel}"><dv:HelpView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:WorkerDialogViewModel}"><dv:WorkerDialogView /></DataTemplate>
            <DataTemplate DataType="{x:Type dvm:ClientBrowserDialogViewModel}"><dv:ClientBrowserDialogView /></DataTemplate>

            <!-- The weekly grid is hosted both by the Agenda page and by the appointment dialog -->
            <DataTemplate DataType="{x:Type evm:WeekGridViewModel}"><ev:WeekGridView /></DataTemplate>

            <!-- The client box is shared by the appointment and sale dialogs -->
            <DataTemplate DataType="{x:Type evm:ClientPickerViewModel}"><ev:ClientPickerView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
