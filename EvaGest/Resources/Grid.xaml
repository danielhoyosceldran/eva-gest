<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:h="clr-namespace:EvaGest.Helpers">

    <!-- Weekly agenda grid (pantalles 2.2). Kept out of Controls.xaml so neither file
         grows past the point where it can be scanned. -->

    <!-- Declared here rather than in App.xaml: App.xaml lists its converters after the
         merged dictionaries, and a StaticResource cannot look forward. -->
    <h:WorkerColorConverter x:Key="WorkerColorConverter" />
    <h:LanePositionConverter x:Key="LanePositionConverter" />

    <sys:Double x:Key="AppointmentBarWidth">4</sys:Double>

    <!-- Closed day: hatched, so "shop shut" never reads the same as "outside hours" -->
    <DrawingBrush x:Key="ClosedDayHatch" TileMode="Tile" Stretch="None"
                  ViewportUnits="Absolute" Viewport="0,0,8,8">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#40D5DBE1">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,8 L8,0 L8,2 L2,8 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Appointment block. A Button so it takes focus, reacts to Enter/Space and marks
         the click handled, which is what keeps a click on a block from also booking a
         new appointment on the empty canvas underneath. -->
    <Style x:Key="GridAppointment" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Background"
                                Background="{Binding ColorHex, Converter={StaticResource WorkerColorConverter}, ConverterParameter=Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlRadius}" />
                        <Border x:Name="Bar" HorizontalAlignment="Left"
                                Width="{StaticResource AppointmentBarWidth}"
                                Background="{Binding ColorHex, Converter={StaticResource WorkerColorConverter}}"
                                CornerRadius="4,0,0,4" />
                        <ContentPresenter Margin="9,2,4,2" />
                        <Border x:Name="Focus" CornerRadius="{StaticResource ControlRadius}"
                                BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                                Visibility="Collapsed" />
                        <Border x:Name="Selection" CornerRadius="{StaticResource ControlRadius}"
                                BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Cancelled and no-show keep their place in the history, dimmed -->
                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource NeutralFgBrush}" />
                        </DataTrigger>
                        <!-- Ghost: where the appointment being edited would land -->
                        <DataTrigger Binding="{Binding IsGhost}" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="#141E40AF" />
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            <Setter TargetName="Background" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource BlueBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppointmentTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AppointmentSubtitle" TargetType="TextBlock" BasedOn="{StaticResource AppointmentTitle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    </Style>

    <Style x:Key="RulerLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Day header. A Button so the whole header is a target for "new appointment
         on this day", matching the old agenda's clickable header. -->
    <Style x:Key="DayHeader" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource PaperBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
