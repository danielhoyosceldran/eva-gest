<UserControl x:Class="EvaGest.Views.Dialogs.TransactionsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:el="clr-namespace:EvaGest.Views.Elements"
             xmlns:h="clr-namespace:EvaGest.Helpers">
    <!-- Every transaction (sales and cash movements), read-only. The window fills the
         screen (FillsScreen); the shell does not scroll, the table does, so its header
         stays in place and its rows are virtualised. -->
    <el:DialogShell ScrollsContent="False">
        <el:DialogShell.Actions>
            <StackPanel>
                <TextBlock Text="{Binding ErrorValidation}" Style="{StaticResource ErrorBanner}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Totals of what is on screen, active rows only. Wraps onto a
                         second line on a narrow screen instead of running off it. -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource DataLabel}" Margin="0,0,24,4" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <TextBlock Text="{x:Static t:Texts.IncomeWithColon}" Style="{StaticResource DataLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IncomeText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <TextBlock Text="{x:Static t:Texts.OutgoingsWithColon}" Style="{StaticResource DataLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OutgoingsText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <TextBlock Text="{x:Static t:Texts.NetWithColon}" Style="{StaticResource DataLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeSubhead}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <TextBlock Text="{x:Static t:Texts.SalesBaseWithColon}" Style="{StaticResource DataLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SalesBaseText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                            <TextBlock Text="{x:Static t:Texts.SalesVatWithColon}" Style="{StaticResource DataLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SalesVatText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="{x:Static t:Texts.ExportTable}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportCommand}" />
                        <Button Content="{x:Static t:Texts.Close}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CloseWindowCommand}" IsCancel="True" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </el:DialogShell.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,12" />

            <!-- Filters. Every box allows an empty selection, meaning "all". -->
            <Border Grid.Row="1" Style="{StaticResource DataCard}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- Period and type on one line on a wide screen, wrapped on a narrow one -->
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                            <DatePicker SelectedDate="{Binding From, Converter={StaticResource DateOnlyConverter}}"
                                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Texts.From}" />
                            <TextBlock Text=" – " VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker SelectedDate="{Binding To, Converter={StaticResource DateOnlyConverter}}"
                                        VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Texts.To}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                            <Button Content="{x:Static t:Texts.Today}" Style="{StaticResource SecondaryButton}"
                                    Padding="10,0" Command="{Binding SelectTodayCommand}" />
                            <Button Content="{x:Static t:Texts.ThisWeek}" Style="{StaticResource SecondaryButton}"
                                    Padding="10,0" Margin="8,0,0,0" Command="{Binding SelectThisWeekCommand}" />
                            <Button Content="{x:Static t:Texts.ThisMonth}" Style="{StaticResource SecondaryButton}"
                                    Padding="10,0" Margin="8,0,0,0" Command="{Binding SelectThisMonthCommand}" />
                            <Button Content="{x:Static t:Texts.ThisYear}" Style="{StaticResource SecondaryButton}"
                                    Padding="10,0" Margin="8,0,0,0" Command="{Binding SelectThisYearCommand}" />
                        </StackPanel>

                        <!-- Type: one segment per kind, the chosen one filled -->
                        <ItemsControl ItemsSource="{Binding KindOptions}" Margin="0,0,0,8" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="TransactionKind"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Margin="0,0,6,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <el:WrappingUniformGrid MinItemWidth="{StaticResource FilterFieldMinWidth}">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static t:Texts.Client}" Style="{StaticResource DataLabel}" />
                            <el:SearchPickerView DataContext="{Binding ClientPicker}" Compact="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static t:Texts.Worker}" Style="{StaticResource DataLabel}" />
                            <el:SearchPickerView DataContext="{Binding WorkerPicker}" Compact="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static t:Texts.Payment}" Style="{StaticResource DataLabel}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FilterMethods}"
                                      SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static t:Texts.Category}" Style="{StaticResource DataLabel}" />
                            <el:SearchPickerView DataContext="{Binding CategoryPicker}" Compact="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static t:Texts.Search}" Style="{StaticResource DataLabel}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     Tag="{x:Static t:Texts.TransactionSearchPlaceholder}" />
                        </StackPanel>
                        <CheckBox Content="{x:Static t:Texts.ShowVoided}" IsChecked="{Binding IncludeVoided}"
                                  VerticalAlignment="Bottom" Margin="0,0,12,10" />
                        <Button Content="{x:Static t:Texts.ClearFilters}" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="8,0"
                                Command="{Binding ClearFiltersCommand}" />
                    </el:WrappingUniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource DataCard}" Padding="0">
                <Grid>
                    <!-- On a narrow screen TableFit hides the optional columns in HideOrder:
                         base and VAT are in the footer, the time and the status are the
                         least needed, and date, type, client, concept and total never go. -->
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" h:TableFit.IsEnabled="True"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource RowHeight}"
                              Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding HasNoResults, Converter={StaticResource InverseVisibilityConverter}}">
                        <!-- A voided row stays listed, greyed out: it is there to be seen,
                             not counted -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Voided}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static t:Texts.Date}" Binding="{Binding DateText}" SortMemberPath="SortKey"
                                                Width="{StaticResource DateColumnWidth}" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn h:TableFit.HideOrder="4" Header="{x:Static t:Texts.Time}" Binding="{Binding TimeText}" SortMemberPath="SortKey"
                                                Width="64" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn Header="{x:Static t:Texts.Type}" Binding="{Binding KindText}"
                                                Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn Header="{x:Static t:Texts.Client}" Binding="{Binding ClientText}"
                                                Width="*" MinWidth="{StaticResource TextColumnMinWidth}" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn h:TableFit.HideOrder="6" Header="{x:Static t:Texts.Worker}" Binding="{Binding WorkerText}"
                                                Width="120" ElementStyle="{StaticResource CellWithTooltip}" />
                            <!-- The concept's tooltip is the detail: each line with its amount, and the notes -->
                            <DataGridTextColumn Header="{x:Static t:Texts.Concept}" Binding="{Binding ConceptText}"
                                                Width="1.5*" MinWidth="{StaticResource TextColumnMinWidth}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding DetailText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn h:TableFit.HideOrder="5" Header="{x:Static t:Texts.Category}" Binding="{Binding CategoryText}"
                                                Width="130" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn h:TableFit.HideOrder="7" Header="{x:Static t:Texts.Payment}" Binding="{Binding MethodText}"
                                                Width="110" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn h:TableFit.HideOrder="1" Header="{x:Static t:Texts.Base}" Binding="{Binding BaseText}" SortMemberPath="Entry.BaseCents"
                                                Width="95" ElementStyle="{StaticResource CellWithTooltip}" />
                            <DataGridTextColumn h:TableFit.HideOrder="2" Header="{x:Static t:Texts.Vat}" Binding="{Binding VatText}" SortMemberPath="Entry.VatCents"
                                                Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                            <!-- Money out in red as well as negative, so the sign is not the only cue -->
                            <DataGridTextColumn Header="{x:Static t:Texts.Total}" Binding="{Binding TotalText}" SortMemberPath="SignedTotalCents"
                                                Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellWithTooltip}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMoneyOut}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn h:TableFit.HideOrder="3" Header="{x:Static t:Texts.Status}" Binding="{Binding StatusText}"
                                                Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: says what to do instead of showing an empty table -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Static t:Texts.NoTransactionMatchesFilters}" TextWrapping="Wrap" MaxWidth="420"
                                   TextAlignment="Center" Style="{StaticResource DataLabel}" HorizontalAlignment="Center" />
                        <Button Content="{x:Static t:Texts.ClearFilters}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </el:DialogShell>
</UserControl>
