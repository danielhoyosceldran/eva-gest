<UserControl x:Class="EvaGest.Views.Dialogs.ClientBrowserDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             FocusManager.FocusedElement="{Binding ElementName=Search}">
    <!-- Every client, scrollable, with a search bar that narrows the list as you type -->
    <StackPanel Width="480">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{x:Static t:Texts.ClientSearchPlaceholderBrowse}" Margin="0,0,0,12" />

        <!-- Fixed height: the dialog is SizeToContent, and a list that grew and shrank
             with every keystroke would make the window jump. -->
        <Border Style="{StaticResource DataCard}" Padding="0" Margin="0,0,0,12" Height="360">
            <Grid>
                <ListBox x:Name="List" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ClientRowItem}" ItemTemplate="{StaticResource ClientRow}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnListDoubleClick" />

                <!-- Empty state: say what to do instead of showing a blank box -->
                <TextBlock Text="{x:Static t:Texts.ClientBrowserEmpty}" TextWrapping="Wrap"
                           Foreground="{StaticResource InkMutedBrush}" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static t:Texts.ChooseClient}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ChooseCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
