<UserControl x:Class="EvaGest.Views.Dialogs.ExportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="360">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBlock Text="{x:Static t:Texts.From}" Style="{StaticResource DataLabel}" />
        <DatePicker SelectedDate="{Binding From}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.To}" Style="{StaticResource DataLabel}" />
        <DatePicker SelectedDate="{Binding To}" Margin="0,0,0,12" />

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                   Text="{x:Static t:Texts.ExportProducesTwoFiles}" />

        <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static t:Texts.Export}" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
