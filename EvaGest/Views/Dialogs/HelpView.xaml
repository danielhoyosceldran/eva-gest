<UserControl x:Class="EvaGest.Views.Dialogs.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="480">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                  Padding="4">
                            <Expander.Header>
                                <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </Expander.Header>
                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkMutedBrush}" Margin="8,8,8,8" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{x:Static t:Texts.Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseHelpCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
