<UserControl x:Class="EvaGest.Views.Dialogs.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:el="clr-namespace:EvaGest.Views.Elements">
    <!-- The questions scroll inside the shell, under a height cap: opening one makes the
         window grow until the cap (or the bottom of the screen) is reached, then the
         list scrolls and Tancar stays where it is. -->
    <el:DialogShell Width="480" MaxHeight="{StaticResource HelpMaxHeight}">
        <el:DialogShell.Actions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static t:Texts.Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseHelpCommand}" IsCancel="True" />
            </StackPanel>
        </el:DialogShell.Actions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

            <ItemsControl ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                  Padding="4">
                            <Expander.Header>
                                <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </Expander.Header>
                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkMutedBrush}" Margin="8,8,8,8" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </el:DialogShell>
</UserControl>
