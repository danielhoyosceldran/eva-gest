<UserControl x:Class="EvaGest.Views.Dialogs.SaleDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:el="clr-namespace:EvaGest.Views.Elements">
    <!-- Laid out to fit a typical sale (four lines) without scrolling on a 1920x1080
         screen at 125 % — the shop's own — which leaves about 1536x816 DIP. Hence the
         paired rows (client | worker, payment | notes) and the totals pinned beside the
         buttons instead of in a card of their own. ResponsiveLayoutTests checks it.
         The dialog is always as tall as the screen (FillsHeight): the lines list takes
         the height the other rows leave free and scrolls by itself. -->
    <UserControl.Resources>
        <!-- Hairlines between the sections (who / what / how) and between paired columns -->
        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ColumnRule" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>
    <el:DialogShell Width="760">
        <el:DialogShell.Actions>
            <StackPanel>
                <TextBlock Text="{Binding ErrorValidation}" Style="{StaticResource ErrorBanner}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Live totals (pantalles 3.2), pinned with the buttons so the amount
                         being charged is always in view, however long the sale grows -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock>
                            <Run Text="{x:Static t:Texts.TotalUpper}" FontSize="{StaticResource FontSizeSmall}"
                                 Foreground="{StaticResource InkMutedBrush}" />
                            <Run Text="{Binding TotalText, Mode=OneWay}" FontFamily="{StaticResource FontDisplay}"
                                 FontSize="{StaticResource FontSizeFigure}" FontWeight="Bold"
                                 Foreground="{StaticResource InkBrush}" />
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource InkMutedBrush}"
                                   Typography.NumeralAlignment="Tabular">
                            <Run Text="{x:Static t:Texts.TaxableBase}" />
                            <Run Text="{Binding BaseText, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{x:Static t:Texts.Vat}" />
                            <Run Text="{Binding VatText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- No IsCancel: the window handles Esc itself so a sale with lines asks before it is discarded (F-02) -->
                        <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                        <Button Content="{x:Static t:Texts.VoidSale}" Style="{StaticResource DestructiveButton}" Command="{Binding VoidSaleCommand}"
                                Visibility="{Binding CurrentMode, Converter={StaticResource EditModeToVisibilityConverter}}" />
                        <Button Content="{x:Static t:Texts.Charge}" Style="{StaticResource PrimaryButton}" Command="{Binding ChargeCommand}" IsDefault="True" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </el:DialogShell.Actions>

        <!-- Fills the shell's visible height; on a screen too short for even the
             minimum list, it grows instead and the whole form scrolls -->
        <el:FillStackPanel FillMinHeight="{StaticResource SaleLinesMinHeight}"
                           ViewportHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,12" />

            <TextBlock Text="{Binding LinkedAppointmentText}" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                       Visibility="{Binding LinkedAppointmentText, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Who: the client and the worker side by side, a rule between them. The
                 client takes two thirds: its toggle has three options (existing / new /
                 no client) to fit in a row. The worker's narrow column puts its list
                 button under the box (Stacked) so the box keeps a usable width. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="33" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Search a registered client or type a guest's name, in the same box -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static t:Texts.Client}" Style="{StaticResource DataLabel}" />
                    <ContentControl Content="{Binding ClientPicker}" Focusable="False" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ColumnRule}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static t:Texts.WorkerOptional}" Style="{StaticResource DataLabel}" />
                    <el:SearchPickerView DataContext="{Binding WorkerPicker}" Stacked="True" />
                </StackPanel>
            </Grid>

            <!-- Non-blocking guest reminder (RF-05bis): offers to register, never requires it -->
            <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding UnregisteredClientNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Text="{x:Static t:Texts.UnregisteredClientSale}" />
                    <Button Content="{x:Static t:Texts.RegisterNow}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding RegisterClientNowCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionRule}" />

            <!-- What: quick buttons for the most sold services, then one search box over
                 services and products. Either adds a line at once. -->
            <TextBlock Text="{x:Static t:Texts.AddToSale}" Style="{StaticResource DataLabel}" />

            <ItemsControl x:Name="QuickServices" ItemsSource="{Binding QuickServices}" Focusable="False" Margin="-3,0,-3,5"
                          Visibility="{Binding QuickServices.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Six across in the 760 DIP dialog; a long name is shortened and
                             shown whole in the tooltip -->
                        <el:WrappingUniformGrid MinItemWidth="120" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SecondaryButton}" Margin="3" Padding="8,4" MinHeight="52"
                                HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}"
                                Command="{Binding DataContext.AddQuickServiceCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                <TextBlock Text="{Binding PriceText}"
                                           FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource InkMutedBrush}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <el:SearchPickerView x:Name="CatalogSearch" Grid.Column="0" DataContext="{Binding CatalogAdder}" />
                <Button Grid.Column="1" Content="{x:Static t:Texts.AddCustomLineButton}" Style="{StaticResource SecondaryButton}"
                        Padding="12,0" MinHeight="{StaticResource FieldHeight}" Margin="8,0,0,0"
                        Command="{Binding AddCustomConceptCommand}" />
            </Grid>

            <!-- The lines: the part that stretches. Its own scroll keeps the rows above
                 and the payment below in view however long the sale grows. -->
            <Grid el:FillStackPanel.Fill="True">
                <!-- Empty state in place of the lines: says how to start instead of a blank -->
                <Border Background="{StaticResource NeutralBgBrush}" CornerRadius="{StaticResource ControlRadius}"
                        Padding="12,10" Margin="0,0,0,8" VerticalAlignment="Top"
                        Visibility="{Binding HasLines, Converter={StaticResource InverseVisibilityConverter}}">
                    <TextBlock Text="{x:Static t:Texts.NoSaleLinesYet}" TextWrapping="Wrap" Foreground="{StaticResource NeutralFgBrush}" />
                </Border>

                <ScrollViewer x:Name="LinesScroll" Focusable="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LineRows" ItemsSource="{Binding Lines}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataCard}" Padding="12,4,4,4" Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- The row: what it is, how many, how much, and its two actions -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeInput}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Description}" Margin="0,0,12,0" />

                                            <!-- Quantity: − / + for the usual one-more, and the box for typing 10 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{StaticResource GlyphMinus}" Style="{StaticResource IconButton}"
                                                        ToolTip="{x:Static t:Texts.DecreaseQuantity}" Command="{Binding DecreaseCommand}" />
                                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="52"
                                                         Margin="4,0" Padding="2,0" TextAlignment="Center"
                                                         ToolTip="{x:Static t:Texts.Quantity}"
                                                         AutomationProperties.Name="{x:Static t:Texts.Quantity}" />
                                                <Button Content="{StaticResource GlyphPlus}" Style="{StaticResource IconButton}"
                                                        ToolTip="{x:Static t:Texts.IncreaseQuantity}" Command="{Binding IncreaseCommand}" />
                                            </StackPanel>

                                            <!-- AmountText, not AmountCents: the raw property is cents and
                                                 printed "1500" for a fifteen-euro line. -->
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" VerticalAlignment="Center"
                                                       Style="{StaticResource TableFigure}" FontSize="{StaticResource FontSizeInput}"
                                                       FontWeight="SemiBold" Margin="0,0,12,0" />

                                            <Button Grid.Column="3" Content="{StaticResource GlyphEdit}" Style="{StaticResource IconButton}"
                                                    ToolTip="{x:Static t:Texts.EditSaleLine}" Command="{Binding ToggleEditCommand}" />
                                            <Button Grid.Column="4" Content="{StaticResource GlyphClose}" Style="{StaticResource IconButton}"
                                                    Foreground="{StaticResource DangerBrush}" Margin="4,0,0,0"
                                                    ToolTip="{x:Static t:Texts.RemoveSaleLine}"
                                                    Command="{Binding DataContext.RemoveLineCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <!-- Behind the pencil: the rarely changed details. Opened by
                                             itself for a custom concept and for a line Cobrar refused. -->
                                        <Grid Margin="0,6,8,6"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Static t:Texts.Concept}" Style="{StaticResource DataLabel}" />
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Static t:Texts.PriceEuros}" Style="{StaticResource DataLabel}" />
                                                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MoneyBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{x:Static t:Texts.VatPercent}" Style="{StaticResource DataLabel}" />
                                                <TextBox Text="{Binding VatText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Style="{StaticResource SectionRule}" />

            <!-- How: payment method and notes side by side, a rule between them -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="33" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Style="{StaticResource ColumnRule}" />
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static t:Texts.PaymentMethod}" Style="{StaticResource DataLabel}" />
                    <!-- One segment per active method, each as wide as its name; only one chosen -->
                    <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding ActiveMethods}"
                             SelectedItem="{Binding PaymentMethod}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static t:Texts.NotesOptional}" Style="{StaticResource DataLabel}" />
                    <!-- One line to start with; grows as a longer note wraps -->
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Grid>
        </el:FillStackPanel>
    </el:DialogShell>
</UserControl>
