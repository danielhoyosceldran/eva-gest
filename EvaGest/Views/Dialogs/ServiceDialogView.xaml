<UserControl x:Class="EvaGest.Views.Dialogs.ServiceDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="360">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBlock Text="{x:Static t:Texts.Name}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.PriceEuros}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.VatPercent}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding VatText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.DurationMinutesOptional}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding DurationMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static t:Texts.Save}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
