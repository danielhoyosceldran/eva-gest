<UserControl x:Class="EvaGest.Views.Dialogs.ClientDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="400">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBlock Text="{x:Static t:Texts.Name}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.Mobile}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.EmailOptional}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.BirthDateOptional}" Style="{StaticResource DataLabel}" />
        <DatePicker SelectedDate="{Binding BirthDate}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.NotesOptional}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,12" />

        <!-- Non-blocking duplicate warning (pantalles 3.3): saving stays possible either way -->
        <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding DuplicateFound, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkBrush}">
                    <Run Text="{x:Static t:Texts.LooksLikeExistingClient}" />
                    <Run Text="{Binding DuplicateFound.Name, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" (" /><Run Text="{Binding DuplicateFound.Mobile, Mode=OneWay}" /><Run Text=")." />
                </TextBlock>
                <Button Content="{x:Static t:Texts.SaveAnyway}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" MinHeight="32" Margin="0,8,0,0"
                        Command="{Binding SaveAnywayCommand}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static t:Texts.Save}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
