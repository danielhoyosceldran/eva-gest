<UserControl x:Class="EvaGest.Views.Dialogs.AppointmentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="FormColumn" Grid.Column="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

            <TextBlock Text="{x:Static t:Texts.Client}" Style="{StaticResource DataLabel}" />
            <ComboBox ItemsSource="{Binding ClientOptions}" SelectedItem="{Binding SelectedOption}"
                      IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}"
                      MinHeight="{StaticResource FieldHeight}" Cursor="Hand">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Disabled rather than hidden for a registered client: the dialog window is
                 SizeToContent, so collapsing these made the whole window jump every time
                 the client type changed. -->
            <StackPanel IsEnabled="{Binding CanWriteGuest}">
                <TextBlock Text="{x:Static t:Texts.GuestName}" Style="{StaticResource DataLabel}" />
                <TextBox Text="{Binding TextClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="{x:Static t:Texts.PhoneOptional}" Style="{StaticResource DataLabel}" />
                <TextBox Text="{Binding GuestPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Static t:Texts.Date}" Style="{StaticResource DataLabel}" />
                    <DatePicker SelectedDate="{Binding Date, Converter={StaticResource DateOnlyConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static t:Texts.Time}" Style="{StaticResource DataLabel}" />
                    <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{x:Static t:Texts.DurationMinutes}" Style="{StaticResource DataLabel}" />
            <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

            <TextBlock Text="{x:Static t:Texts.ServiceOptional}" Style="{StaticResource DataLabel}" />
            <ComboBox ItemsSource="{Binding ActiveServices}" SelectedItem="{Binding Service}"
                      DisplayMemberPath="Name" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}" />

            <TextBlock Text="{x:Static t:Texts.WorkerOptional}" Style="{StaticResource DataLabel}" />
            <ComboBox ItemsSource="{Binding ActiveWorkers}" SelectedItem="{Binding Worker}"
                      DisplayMemberPath="Name" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}" />

            <TextBlock Text="{x:Static t:Texts.NotesOptional}" Style="{StaticResource DataLabel}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="0,0,0,12" />

            <!-- Non-blocking inline warnings (pantalles 3.1) -->
            <StackPanel Margin="0,0,0,12">
                <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,0,0,6"
                        Visibility="{Binding OverlapNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static t:Texts.PossibleOverlap}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,0,0,6"
                        Visibility="{Binding OutsideScheduleNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static t:Texts.OutsideOpeningHours}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10"
                        Visibility="{Binding ClosedDayNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ClosedDayReason, StringFormat={x:Static t:Texts.ClosedDayFormat}}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,6,0,0"
                        Visibility="{Binding UnregisteredClientNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="{x:Static t:Texts.UnregisteredClientAppointment}" />
                        <Button Content="{x:Static t:Texts.RegisterNow}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding RegisterClientNowCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Kept away from Guardar and hidden on a new appointment, which has
                     nothing to delete: Cancel·lar already discards it -->
                <Button Grid.Column="0" Content="{x:Static t:Texts.Delete}" Style="{StaticResource DestructiveButton}"
                        HorizontalAlignment="Left" Command="{Binding DeleteCommand}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{x:Static t:Texts.Save}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" IsDefault="True" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- The same weekly grid as the Agenda page. Clicking a slot sets the date and
             hour; the dashed ghost block shows the duration colliding with its neighbours
             before the warnings on the left even fire.
             The width is fixed and the panel is never collapsed: the dialog window is
             SizeToContent, so it measures itself once while the grid is still loading and
             would otherwise open too narrow to show the week.
             The height is capped to the form column instead: the grid is a ScrollViewer
             over the whole opening day, so with SizeToContent measuring at infinity it
             would otherwise ask for the full day and push the window past the screen. -->
        <Grid Grid.Column="1" Width="700" Margin="20,0,0,0"
              MaxHeight="{Binding ActualHeight, ElementName=FormColumn}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static t:Texts.PickTimeInAgenda}" Style="{StaticResource DataLabel}"
                       Margin="0,4,0,4" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="‹" Style="{StaticResource SecondaryButton}" MinWidth="44"
                        Command="{Binding Grid.WeekPreviousCommand}" />
                <TextBlock Grid.Column="1" Text="{Binding Grid.RangeText}" Margin="12,0"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource FontUi}" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <Button Grid.Column="2" Content="›" Style="{StaticResource SecondaryButton}" MinWidth="44"
                        Command="{Binding Grid.WeekNextCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{x:Static t:Texts.Today}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding Grid.ThisWeekCommand}" />
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource SurfaceRadius}" ClipToBounds="True"
                    VerticalAlignment="Stretch">
                <ContentControl Content="{Binding Grid}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
