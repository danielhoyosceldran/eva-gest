<UserControl x:Class="EvaGest.Views.Dialogs.OwnerPinDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="380">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Intro, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Visibility="{Binding AsksCurrentPin, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static t:Texts.CurrentPin}" Style="{StaticResource DataLabel}" />
            <PasswordBox x:Name="CurrentPinBox" MaxLength="6" Margin="0,0,0,12" PasswordChanged="OnPinChanged" />
        </StackPanel>

        <TextBlock Text="{x:Static t:Texts.NewPin}" Style="{StaticResource DataLabel}" />
        <PasswordBox x:Name="NewPinBox" MaxLength="6" Margin="0,0,0,12" PasswordChanged="OnPinChanged" />

        <TextBlock Text="{x:Static t:Texts.RepeatPin}" Style="{StaticResource DataLabel}" />
        <PasswordBox x:Name="RepeatPinBox" MaxLength="6" Margin="0,0,0,12" PasswordChanged="OnPinChanged" />

        <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{Binding SaveText}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsDefault="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
