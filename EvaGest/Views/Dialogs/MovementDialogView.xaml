<UserControl x:Class="EvaGest.Views.Dialogs.MovementDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="360">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" Margin="0,0,0,16" />

        <TextBlock Text="{x:Static t:Texts.AmountEuros}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static t:Texts.PaymentMethod}" Style="{StaticResource DataLabel}" />
        <ComboBox ItemsSource="{Binding ActiveMethods}" SelectedItem="{Binding Method}"
                  DisplayMemberPath="Name" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}" />

        <TextBlock Text="{x:Static t:Texts.Concept}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Concept, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <CheckBox Content="{x:Static t:Texts.SplitVat}" IsChecked="{Binding SplitVat}" Margin="0,0,0,12"
                  FontSize="{StaticResource FontSizeInput}" />

        <StackPanel Visibility="{Binding SplitVat, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static t:Texts.VatPercentage}" Style="{StaticResource DataLabel}" />
            <TextBox Text="{Binding VatText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="{x:Static t:Texts.NotesOptional}" Style="{StaticResource DataLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorValidation}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidation, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static t:Texts.Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static t:Texts.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
