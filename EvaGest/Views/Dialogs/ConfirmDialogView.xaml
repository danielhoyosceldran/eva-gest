<UserControl x:Class="EvaGest.Views.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:el="clr-namespace:EvaGest.Views.Elements">
    <!-- A question with two concrete answers, in the app's language (replaces the
         Windows MessageBox and its Yes / No). Esc answers with the way back. -->
    <el:DialogShell Width="440" Margin="8">
        <el:DialogShell.Actions>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" IsCancel="True" />
                <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}" Margin="8,0,0,0" />
            </WrapPanel>
        </el:DialogShell.Actions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>
    </el:DialogShell>
</UserControl>
