<UserControl x:Class="EvaGest.Views.Dialogs.ClientRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <StackPanel Width="480">
        <!-- Header -->
        <TextBlock Text="{Binding Client.Name}" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
        <TextBlock Text="{x:Static t:Texts.Asleep}" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                   Visibility="{Binding Client.Asleep, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Contact data -->
        <TextBlock Style="{StaticResource DataLabel}">
            <Run Text="{x:Static t:Texts.MobilePrefix}" /><Run Text="{Binding Client.Mobile, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource DataLabel}" Text="{Binding Client.Email, StringFormat={x:Static t:Texts.EmailFormat}}"
                   Visibility="{Binding Client.Email, Converter={StaticResource NullToVisibilityConverter}}" />

        <!-- Indicators -->
        <TextBlock Text="{x:Static t:Texts.Indicators}" Style="{StaticResource Subtitle}" />
        <UniformGrid Columns="3" Rows="2">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="{x:Static t:Texts.Visits}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding Indicators.Visits}" Style="{StaticResource Figure}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="{x:Static t:Texts.CancelledPlural}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding Indicators.Cancelled}" Style="{StaticResource Figure}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{x:Static t:Texts.NoShowPlural}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding Indicators.NoShows}" Style="{StaticResource Figure}" />
            </StackPanel>
            <!-- Hidden (not blanked) when owner mode is closed; the UniformGrid then
                 closes the gap and frequency moves up next to the counts. -->
            <StackPanel Margin="0,0,12,0"
                        Visibility="{Binding ShowAmounts, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Static t:Texts.TotalSpent}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding TotalSpentText}" Style="{StaticResource Figure}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0"
                        Visibility="{Binding ShowAmounts, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Static t:Texts.AveragePerVisit}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding AverageText}" Style="{StaticResource Figure}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.FrequencyDays}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource Figure}" />
            </StackPanel>
        </UniformGrid>

        <!-- History -->
        <TextBlock Text="{x:Static t:Texts.History}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Padding="0" MaxHeight="220">
            <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource RowHeight}"
                      Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static t:Texts.Date}" Binding="{Binding Date}" Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="{x:Static t:Texts.Type}" Binding="{Binding Type}" Width="70" ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="{x:Static t:Texts.Concept}" Binding="{Binding Concept}" Width="*" ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="{x:Static t:Texts.Status}" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource CellWithTooltip}" />
                    <DataGridTextColumn Header="{x:Static t:Texts.Amount}" Binding="{Binding Amount}" Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static t:Texts.Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseRecordCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                    Command="{Binding SleepWakeCommand}"
                    Content="{Binding SleepWakeText}" />
            <Button Content="{x:Static t:Texts.Delete}" Style="{StaticResource DestructiveButton}" Command="{Binding DeleteCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
