<UserControl x:Class="EvaGest.Views.Pagines.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PadPagina}">
            <TextBlock Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TextCerca, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Cerca per nom o mòbil…" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="+ Nou client" Style="{StaticResource BotoPrimari}"
                        Command="{Binding NouClientCommand}" />
            </Grid>

            <Border Style="{StaticResource TargetaDada}" Padding="0">
                <DataGrid ItemsSource="{Binding Actius}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Mòbil" Binding="{Binding Mobil}" Width="130" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <!-- Visites / Total gastat / Última visita venen dels indicadors agregats
                             (RF-17), que InformesService calcula a partir de Fase 8. Fins llavors
                             no es mostren xifres inventades. -->
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Fitxa" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.ObrirFitxaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EditarClientCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ToggleButton x:Name="ToggleAdormits" IsChecked="{Binding MostrarAdormits}"
                          HorizontalAlignment="Left" Margin="0,20,0,10" Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Fletxa" Data="M0,0 L4,4 L8,0" Stretch="None"
                                      Stroke="{StaticResource InkMutedBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock x:Name="Text" Text="Mostrar clients adormits"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           FontSize="{StaticResource FontSizeSubhead}"
                                           TextDecorations="Underline" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Text" Property="Text" Value="Amagar clients adormits" />
                                <Setter TargetName="Fletxa" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Border Style="{StaticResource TargetaDada}" Padding="0"
                    Visibility="{Binding MostrarAdormits, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Adormits}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Mòbil" Binding="{Binding Mobil}" Width="130" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTemplateColumn Header="" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Despertar" Style="{StaticResource BotoSecundari}"
                                            HorizontalAlignment="Right" Padding="10,0" MinHeight="32"
                                            Command="{Binding DataContext.DespertarCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
