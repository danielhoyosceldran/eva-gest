<UserControl x:Class="EvaGest.Views.Pagines.VendesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <Grid Margin="{StaticResource PadPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Exportar període" Style="{StaticResource BotoSecundari}"
                        Command="{Binding ExportarPeriodeCommand}" />
                <Button Content="+ Nova venda" Style="{StaticResource BotoPrimari}" Margin="12,0,0,0"
                        Command="{Binding NovaVendaCommand}" />
            </StackPanel>

            <!-- Quiet note under the title: says when "eliminar" only cancelled the sale (RF-10) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding Avis, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Avis}" TextWrapping="Wrap" Style="{StaticResource EtiquetaDada}" />
            </Border>
        </Grid>

        <!-- Filtres (RF-15). Every picker allows an empty selection, which means "totes" -->
        <Border Grid.Row="1" Style="{StaticResource TargetaDada}" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Des de" Style="{StaticResource EtiquetaDada}" />
                    <DatePicker Width="130"
                                SelectedDate="{Binding Des, Converter={StaticResource DateOnlyConverter}}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Fins a" Style="{StaticResource EtiquetaDada}" />
                    <DatePicker Width="130"
                                SelectedDate="{Binding Fins, Converter={StaticResource DateOnlyConverter}}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Client" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="160" ItemsSource="{Binding ClientsFiltre}" SelectedItem="{Binding Client}"
                              DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Servei" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="140" ItemsSource="{Binding ServeisFiltre}" SelectedItem="{Binding Servei}"
                              DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Producte" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="140" ItemsSource="{Binding ProductesFiltre}" SelectedItem="{Binding Producte}"
                              DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Pagament" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="120" ItemsSource="{Binding MetodesFiltre}"
                              SelectedItem="{Binding MetodePagament}" DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Treballadora" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="140" ItemsSource="{Binding TreballadoresFiltre}"
                              SelectedItem="{Binding Treballadora}" DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Estat" Style="{StaticResource EtiquetaDada}" />
                    <ComboBox Width="120" ItemsSource="{Binding EstatsFiltre}" SelectedItem="{Binding Estat}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EtiquetaConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Content="Netejar filtres" Style="{StaticResource BotoSecundari}"
                        VerticalAlignment="Bottom" Margin="0,0,0,8"
                        Command="{Binding NetejarFiltresCommand}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TargetaDada}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Vendes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                          Visibility="{Binding NoHiHaResultats, Converter={StaticResource InversAVisibilitatConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="100" />
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientText}" Width="*" />
                        <DataGridTextColumn Header="Treballadora" Binding="{Binding TreballadoraText}" Width="130" />
                        <DataGridTextColumn Header="Concepte" Binding="{Binding ConcepteText}" Width="*" />
                        <DataGridTextColumn Header="Base" Binding="{Binding BaseText}" Width="95" />
                        <DataGridTextColumn Header="IVA" Binding="{Binding IvaText}" Width="90" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="100" />
                        <DataGridTextColumn Header="Pagament" Binding="{Binding MetodeText}" Width="110" />
                        <DataGridTextColumn Header="Estat" Binding="{Binding EstatText}" Width="90" />
                        <DataGridTemplateColumn Header="" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditarVendaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Venda}" />
                                        <!-- Only an active sale can be cancelled: doing it twice
                                             would suggest a second, different effect -->
                                        <Button Content="Anul·lar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Foreground="{StaticResource DangerBrush}"
                                                Visibility="{Binding PotAnullar, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.AnullarVendaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Venda}" />
                                        <!-- On an active sale this only cancels it and says so;
                                             on an already cancelled one it wipes it for good -->
                                        <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EliminarVendaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Venda}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                            Visibility="{Binding NoHiHaResultats, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Cap venda coincideix amb aquests filtres."
                               Style="{StaticResource EtiquetaDada}" HorizontalAlignment="Center" />
                    <Button Content="Netejar filtres" Style="{StaticResource BotoSecundari}"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Command="{Binding NetejarFiltresCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer totals cover only the ACTIVE sales (pantalles 2.6) -->
        <Border Grid.Row="3" Style="{StaticResource TargetaDada}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource EtiquetaDada}" VerticalAlignment="Center"
                           Text="{Binding ComptadorActives, StringFormat={}{0} vendes actives}" />
                <TextBlock Text="Base:" Style="{StaticResource EtiquetaDada}" Margin="24,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalBaseText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="IVA:" Style="{StaticResource EtiquetaDada}" Margin="24,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalIvaText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Total:" Style="{StaticResource EtiquetaDada}" Margin="24,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalTotalText}" VerticalAlignment="Center" FontWeight="SemiBold"
                           FontFamily="{StaticResource FontUi}" FontSize="{StaticResource FontSizeSubhead}"
                           Foreground="{StaticResource InkBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
