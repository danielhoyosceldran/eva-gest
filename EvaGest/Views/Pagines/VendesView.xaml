<UserControl x:Class="EvaGest.Views.Pagines.VendesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <StackPanel Margin="{StaticResource PadPagina}">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />
            <Button Grid.Column="1" Content="+ Nova venda" Style="{StaticResource BotoPrimari}"
                    Command="{Binding NovaVendaCommand}" VerticalAlignment="Top" />
        </Grid>

        <Border Style="{StaticResource TargetaDada}" Padding="0">
            <DataGrid ItemsSource="{Binding Vendes}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                      Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="90" />
                    <DataGridTextColumn Header="Client" Binding="{Binding NomMostrat}" Width="*" />
                    <DataGridTextColumn Header="Treballadora" Binding="{Binding Treballadora.Nom}" Width="120" />
                    <DataGridTextColumn Header="Base" Binding="{Binding BaseCents, StringFormat={}{0:0.00}}" Width="80" />
                    <DataGridTextColumn Header="IVA" Binding="{Binding IvaCents, StringFormat={}{0:0.00}}" Width="80" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCents, StringFormat={}{0:0.00}}" Width="80" />
                    <DataGridTextColumn Header="Pagament" Binding="{Binding MetodePagament.Nom}" Width="100" />
                    <DataGridTextColumn Header="Estat" Binding="{Binding Estat}" Width="90" />
                    <DataGridTemplateColumn Header="" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                            Padding="10,0" MinHeight="32"
                                            Command="{Binding DataContext.EditarVendaCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Anul·lar" Style="{StaticResource BotoSecundari}"
                                            Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                            Command="{Binding DataContext.AnullarVendaCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
