<UserControl x:Class="EvaGest.Views.Pagines.ConfiguracioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PadPagina}">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

        <TextBlock Text="Horari d'obertura" Style="{StaticResource Subtitol}" />
        <Border Style="{StaticResource TargetaDada}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Quan obre la barberia cada dia. Deixa la segona franja buida si fas horari seguit. L'agenda ombreja les hores que queden fora."
                           Style="{StaticResource EtiquetaDada}" Margin="0,0,0,12" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Obert" Style="{StaticResource EtiquetaDada}" />
                    <TextBlock Grid.Column="2" Text="Primera franja" Style="{StaticResource EtiquetaDada}" Width="170" />
                    <TextBlock Grid.Column="3" Text="Segona franja (opcional)" Style="{StaticResource EtiquetaDada}" Width="170" />
                </Grid>

                <ItemsControl ItemsSource="{Binding DiesHorari}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding NomDia}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontUi}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource InkBrush}" />

                                    <CheckBox Grid.Column="1" IsChecked="{Binding Obert}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding Obert}">
                                        <TextBox Text="{Binding MatiInici, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" TextAlignment="Center" />
                                        <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBox Text="{Binding MatiFi, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" TextAlignment="Center" Margin="0,0,20,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" IsEnabled="{Binding Obert}">
                                        <TextBox Text="{Binding TardaInici, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" TextAlignment="Center" />
                                        <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBox Text="{Binding TardaFi, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="70" TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="120,2,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ErrorHorari}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorHorari, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding ConfirmacioHorari}" Foreground="{StaticResource InkMutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ConfirmacioHorari, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Desar horari" Style="{StaticResource BotoPrimari}"
                            Command="{Binding GuardarHorariCommand}" />
                    <Button Content="Copiar dilluns a dimarts–divendres" Style="{StaticResource BotoSecundari}"
                            Margin="12,0,0,0" Command="{Binding AplicarDillunsALaRestaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Agenda" Style="{StaticResource Subtitol}" />
        <Border Style="{StaticResource TargetaDada}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Alçada de cada franja de la graella setmanal. Com més petita, més precisió en triar l'hora."
                           Style="{StaticResource EtiquetaDada}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding OpcionsMinutsSlot}" SelectedItem="{Binding MinutsSlot}"
                          HorizontalAlignment="Left" MinWidth="160"
                          FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} minuts}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <TextBlock Text="Còpies de seguretat" Style="{StaticResource Subtitol}" />
        <Border Style="{StaticResource TargetaDada}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding UltimaCopiaText}" Style="{StaticResource EtiquetaDada}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Fer còpia ara" Style="{StaticResource BotoPrimari}" Command="{Binding FerCopiaAraCommand}" />
                    <Button Content="Restaurar còpia" Style="{StaticResource BotoSecundari}" Margin="12,0,0,0"
                            Command="{Binding RestaurarCopiaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Exportació per a l'assessoria" Style="{StaticResource Subtitol}" />
        <Border Style="{StaticResource TargetaDada}">
            <StackPanel>
                <TextBlock Text="Genera els fitxers de vendes i IVA d'un període per portar-los a la gestoria."
                           Style="{StaticResource EtiquetaDada}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <Button Content="Exportar període" Style="{StaticResource BotoSecundari}"
                        HorizontalAlignment="Left" Command="{Binding ExportarDadesCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
