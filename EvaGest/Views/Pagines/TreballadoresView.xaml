<UserControl x:Class="EvaGest.Views.Pagines.TreballadoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PadPagina}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />
                <Button Grid.Column="1" Content="+ Nova treballadora" Style="{StaticResource BotoPrimari}"
                        Command="{Binding NovaTreballadoraCommand}" VerticalAlignment="Top" />
            </Grid>

            <!-- Quiet note: says when a delete became a deactivation because she already
                 has appointments or sales (RF-10) -->
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding Avis, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Avis}" TextWrapping="Wrap" Style="{StaticResource EtiquetaDada}" />
            </Border>

            <!-- Empty state: a bare table would not say what to do next (pantalles 1) -->
            <Border Style="{StaticResource TargetaDada}"
                    Visibility="{Binding NoHiHaCap, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Encara no has donat d'alta cap treballadora."
                               Style="{StaticResource EtiquetaDada}" TextWrapping="Wrap" />
                    <TextBlock Text="Fins que no n'hi hagi cap amb horari, l'agenda no sap quantes persones hi ha per atendre i avisa de solapament a totes les cites."
                               Style="{StaticResource EtiquetaDada}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Button Content="+ Nova treballadora" Style="{StaticResource BotoPrimari}"
                            HorizontalAlignment="Left" Command="{Binding NovaTreballadoraCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TargetaDada}" Padding="0" Margin="0,0,0,16"
                    Visibility="{Binding NoHiHaCap, Converter={StaticResource InversAVisibilitatConverter}}">
                <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nom" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Treballadora.Color}" />
                                        <TextBlock Text="{Binding Treballadora.Nom}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Horari" Binding="{Binding HorariResum}" Width="2*" />
                        <DataGridTextColumn Header="Estat" Binding="{Binding EstatText}" Width="90" />
                        <DataGridTemplateColumn Header="" Width="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditarTreballadoraCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Treballadora}" />
                                        <Button Content="{Binding AccioEstatText}" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.CanviarEstatCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Treballadora}" />
                                        <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EliminarTreballadoraCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Treballadora}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Weekly overview: who covers which day, at a glance -->
            <StackPanel Visibility="{Binding NoHiHaCap, Converter={StaticResource InversAVisibilitatConverter}}">
                <TextBlock Text="Horari setmanal" Style="{StaticResource Subtitol}" />
                <Border Style="{StaticResource TargetaDada}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding NomsDies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                                   Style="{StaticResource EtiquetaDada}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Treballadora.Nom}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource FontUi}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{StaticResource InkBrush}" />

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Dies}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- The tooltip carries the actual hours: colour alone
                                                         never has to be the only source of information -->
                                                    <Border Height="24" Margin="2,0" CornerRadius="3"
                                                            Background="{Binding Hex}"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding Detall}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
