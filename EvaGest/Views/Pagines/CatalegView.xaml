<UserControl x:Class="EvaGest.Views.Pagines.CatalegView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PadPagina}">
            <TextBlock Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

            <!-- Quiet note, not a dialog: the delete did happen, it just turned into a
                 deactivation because the history points at the entry (RF-10) -->
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding Avis, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Avis}" TextWrapping="Wrap" Style="{StaticResource EtiquetaDada}" />
            </Border>

            <!-- Serveis -->
            <TextBlock Text="Serveis" Style="{StaticResource Subtitol}" />
            <Button Content="+ Nou servei" Style="{StaticResource BotoSecundari}"
                    HorizontalAlignment="Left" Command="{Binding NouServeiCommand}" Margin="0,0,0,12" />
            <Border Style="{StaticResource TargetaDada}" Padding="0">
                <DataGrid ItemsSource="{Binding Serveis}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Servei.Nom}" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Preu" Binding="{Binding PreuText}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="IVA" Binding="{Binding IvaText}" Width="80" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Durada" Binding="{Binding DuradaText}" Width="80" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridCheckBoxColumn Header="Actiu" Binding="{Binding Servei.Actiu}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditarServeiCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Servei}" />
                                        <Button Content="Activar/Desactivar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.CanviarEstatServeiCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Servei}" />
                                        <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EliminarServeiCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Servei}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Productes -->
            <TextBlock Text="Productes" Style="{StaticResource Subtitol}" />
            <Button Content="+ Nou producte" Style="{StaticResource BotoSecundari}"
                    HorizontalAlignment="Left" Command="{Binding NouProducteCommand}" Margin="0,0,0,12" />
            <Border Style="{StaticResource TargetaDada}" Padding="0">
                <DataGrid ItemsSource="{Binding Productes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Producte.Nom}" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Preu" Binding="{Binding PreuText}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Producte.Categoria}" Width="120" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="IVA" Binding="{Binding IvaText}" Width="80" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridCheckBoxColumn Header="Actiu" Binding="{Binding Producte.Actiu}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditarProducteCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Producte}" />
                                        <Button Content="Activar/Desactivar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.CanviarEstatProducteCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Producte}" />
                                        <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EliminarProducteCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Producte}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Mètodes de pagament -->
            <TextBlock Text="Mètodes de pagament" Style="{StaticResource Subtitol}" />
            <Button Content="+ Nou mètode" Style="{StaticResource BotoSecundari}"
                    HorizontalAlignment="Left" Command="{Binding NouMetodeCommand}" Margin="0,0,0,12" />
            <Border Style="{StaticResource TargetaDada}" Padding="0">
                <DataGrid ItemsSource="{Binding Metodes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridCheckBoxColumn Header="Actiu" Binding="{Binding Actiu}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Editar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditarMetodeCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Activar/Desactivar" Style="{StaticResource BotoSecundari}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.CanviarEstatMetodeCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.EliminarMetodeCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
