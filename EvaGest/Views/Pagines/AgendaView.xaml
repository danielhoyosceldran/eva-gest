<UserControl x:Class="EvaGest.Views.Pagines.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <Grid Margin="{StaticResource PadPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

        <!-- Week header -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹ Setmana anterior" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.SetmanaAnteriorCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding Graella.RangText}" Style="{StaticResource Subtitol}"
                       Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="2" Content="Setmana següent ›" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.SetmanaSeguentCommand}" Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="Aquesta setmana" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.AquestaSetmanaCommand}" Margin="0,0,12,0" />
            <Button Grid.Column="4" Content="+ Nova cita" Style="{StaticResource BotoPrimari}"
                    Command="{Binding NovaCitaCommand}" />
        </Grid>

        <!-- The week itself is the shared time grid: full size here, embedded in the
             cita dialog as the hour picker. Click an empty slot to book there, click an
             appointment to edit it. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiSuperficie}" ClipToBounds="True">
            <ContentControl Content="{Binding Graella}" />
        </Border>
    </Grid>
</UserControl>
