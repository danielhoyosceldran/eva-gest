<UserControl x:Class="EvaGest.Views.Pagines.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <Grid Margin="{StaticResource PadPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

            <!-- Quiet note: mostly why an appointment with a sale was not deleted -->
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding Avis, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Avis}" TextWrapping="Wrap" Style="{StaticResource EtiquetaDada}" />
            </Border>
        </StackPanel>

        <!-- Week header -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹ Setmana anterior" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.SetmanaAnteriorCommand}" />
            <TextBlock Grid.Column="1" Text="{Binding Graella.RangText}" Style="{StaticResource Subtitol}"
                       Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button Grid.Column="2" Content="Setmana següent ›" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.SetmanaSeguentCommand}" Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="Aquesta setmana" Style="{StaticResource BotoSecundari}"
                    Command="{Binding Graella.AquestaSetmanaCommand}" Margin="0,0,12,0" />
            <Button Grid.Column="4" Content="+ Nova cita" Style="{StaticResource BotoPrimari}"
                    Command="{Binding NovaCitaCommand}" />
        </Grid>

        <!-- The week itself is the shared time grid: full size here, embedded in the
             cita dialog as the hour picker. Click an empty slot to book there, click an
             appointment to edit it. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiSuperficie}" ClipToBounds="True">
                <ContentControl Content="{Binding Graella}" />
            </Border>

            <!-- Day detail (pantalles 2.2): opens from a column header, and shows the
                 status buttons the compact grid cards keep hidden until hover. -->
            <Border Grid.Column="1" Width="400" Margin="16,0,0,0"
                    Style="{StaticResource TargetaDada}"
                    Visibility="{Binding HiHaDiaSeleccionat, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DiaSeleccionatText}"
                                   Style="{StaticResource Subtitol}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Tancar" Style="{StaticResource BotoSecundari}"
                                Padding="10,0" MinHeight="32" VerticalAlignment="Top"
                                Command="{Binding TancarDetallCommand}" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="Aquest dia no té cap cita apuntada."
                               Style="{StaticResource EtiquetaDada}" TextWrapping="Wrap"
                               Visibility="{Binding DiaSenseCites, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CitesDelDia}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding HoraText}" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource FontUi}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding DuradaText}" Margin="8,0,0,0"
                                                           Style="{StaticResource EtiquetaDada}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding EstatText}" Margin="12,0,0,0"
                                                           Style="{StaticResource EtiquetaDada}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ClientText}"
                                                           FontFamily="{StaticResource FontUi}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="(no registrat)" Margin="6,0,0,0"
                                                           Style="{StaticResource EtiquetaDada}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding EsConvidat, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ServeiText}" Style="{StaticResource EtiquetaDada}" />
                                                <Ellipse Width="8" Height="8" Margin="12,0,6,0"
                                                         VerticalAlignment="Center" Fill="{Binding ColorHex}" />
                                                <TextBlock Text="{Binding TreballadoraText}" Style="{StaticResource EtiquetaDada}" />
                                            </StackPanel>

                                            <!-- Only a pending appointment still has a state to move to -->
                                            <WrapPanel Margin="0,8,0,0"
                                                       Visibility="{Binding EsPendent, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button Content="Realitzada" Style="{StaticResource BotoSecundari}"
                                                        Padding="10,0" MinHeight="32" Margin="0,0,8,4"
                                                        Command="{Binding DataContext.MarcarRealitzadaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Cita}" />
                                                <Button Content="Cancel·lada" Style="{StaticResource BotoSecundari}"
                                                        Padding="10,0" MinHeight="32" Margin="0,0,8,4"
                                                        Command="{Binding DataContext.MarcarCancelladaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Cita}" />
                                                <Button Content="No assistida" Style="{StaticResource BotoSecundari}"
                                                        Padding="10,0" MinHeight="32" Margin="0,0,0,4"
                                                        Command="{Binding DataContext.MarcarNoAssistidaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Cita}" />
                                            </WrapPanel>

                                            <!-- For the entries that should never have been
                                                 booked. Available whatever the state: a wrong
                                                 appointment is wrong once it is done too. -->
                                            <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}"
                                                    Padding="10,0" MinHeight="32" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.EliminarCitaCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Cita}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
