<UserControl x:Class="EvaGest.Views.Pagines.InformesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PadPagina}">
            <TextBlock Text="{Binding Titol}" Style="{StaticResource TitolPagina}" />

            <!-- A) Visió general -->
            <TextBlock Text="Visió general" Style="{StaticResource Subtitol}" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TargetaDada}">
                    <StackPanel>
                        <TextBlock Text="Evolució de vendes (12 mesos)" Style="{StaticResource EtiquetaDada}" />
                        <ItemsControl ItemsSource="{Binding Evolucio}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="140" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="40" Margin="4,0" VerticalAlignment="Bottom">
                                        <Border Height="{Binding AlcadaDip}" Background="{StaticResource BlauBrush}"
                                                CornerRadius="2" VerticalAlignment="Bottom"
                                                ToolTip="{Binding ImportText}" />
                                        <TextBlock Text="{Binding Etiqueta}" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TargetaHero}">
                    <StackPanel>
                        <TextBlock Text="Client del mes" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding ClientDelMesText}" Style="{StaticResource Subtitol}"
                                   TextWrapping="Wrap" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- B) Rànquings de clients -->
            <TextBlock Text="Rànquings de clients" Style="{StaticResource Subtitol}" />
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Més visites" Style="{StaticResource EtiquetaDada}" />
                        <ItemsControl ItemsSource="{Binding TopVisites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{Binding Client.Nom, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Visites, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Més despesa" Style="{StaticResource EtiquetaDada}" />
                        <ItemsControl ItemsSource="{Binding TopDespesa}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Client.Nom}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Major mitjana" Style="{StaticResource EtiquetaDada}" />
                        <ItemsControl ItemsSource="{Binding TopMitjana}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Client.Nom}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}">
                    <StackPanel>
                        <TextBlock Text="Fa temps que no vénen" Style="{StaticResource EtiquetaDada}" />
                        <ItemsControl ItemsSource="{Binding FaTemps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4">
                                        <Run Text="{Binding Client.Nom, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding DiesSense, Mode=OneWay}" />
                                        <Run Text=" dies" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Period selector shared by C and D -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <DatePicker SelectedDate="{Binding Des}" FontSize="{StaticResource FontSizeInput}" />
                <TextBlock Text=" – " VerticalAlignment="Center" Margin="8,0" />
                <DatePicker SelectedDate="{Binding Fins}" FontSize="{StaticResource FontSizeInput}" />
            </StackPanel>

            <!-- C) Rànquing de treballadores -->
            <TextBlock Text="Rànquing de treballadores" Style="{StaticResource Subtitol}" />
            <Border Style="{StaticResource TargetaDada}" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding RanquingTreballadores}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Vendes ateses" Binding="{Binding VendesAteses}" Width="110" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Ingressos" Binding="{Binding IngressosCents, StringFormat={}{0:0.00}}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="% de treball" Binding="{Binding PercentatgeTreball, StringFormat={}{0:0.0}%, TargetNullValue=—}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- D) Detall per treballadora -->
            <TextBlock Text="Detall per treballadora" Style="{StaticResource Subtitol}" />
            <ComboBox ItemsSource="{Binding Treballadores}" SelectedItem="{Binding TreballadoraSeleccionada}"
                      DisplayMemberPath="Nom" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12"
                      FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}" />

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Vendes ateses" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding DetallSeleccionat.VendesAteses}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Ingressos generats" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding DetallSeleccionat.IngressosCents, StringFormat={}{0:0.00} €}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}">
                    <StackPanel>
                        <TextBlock Text="% de treball realitzat" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding DetallSeleccionat.PercentatgeTreball, StringFormat={}{0:0.0} %, TargetNullValue=—}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
