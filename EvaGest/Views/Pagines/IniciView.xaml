<UserControl x:Class="EvaGest.Views.Pagines.IniciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PadPagina}">
            <TextBlock Text="{Binding DataText}" Style="{StaticResource TitolPagina}" />

            <!-- Birthday alert: only visible when someone actually has one today -->
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding AvisAniversariText, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding AvisAniversariText}" TextWrapping="Wrap" />
            </Border>

            <!-- Summary cards -->
            <UniformGrid Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cites avui" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding CitesAvui}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Vendes avui" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding VendesAvui}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cobrat avui" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding CobratAvuiText}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Entrades" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding EntradesText}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaDada}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Sortides" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding SortidesText}" Style="{StaticResource Xifra}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TargetaHero}">
                    <StackPanel>
                        <TextBlock Text="Balanç del dia" Style="{StaticResource EtiquetaDada}" />
                        <TextBlock Text="{Binding BalancText}" Style="{StaticResource XifraHero}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick actions -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Button Content="Nova cita" Style="{StaticResource BotoAccioRapida}" Margin="0,0,8,0" Command="{Binding NovaCitaCommand}" />
                <Button Content="Nova venda" Style="{StaticResource BotoAccioRapida}" Margin="0,0,8,0" Command="{Binding NovaVendaCommand}" />
                <Button Content="Nou client" Style="{StaticResource BotoAccioRapida}" Margin="0,0,8,0" Command="{Binding NouClientCommand}" />
                <Button Content="Entrada" Style="{StaticResource BotoAccioRapida}" Margin="0,0,8,0" Command="{Binding NovaEntradaCommand}" />
                <Button Content="Sortida" Style="{StaticResource BotoAccioRapida}" Command="{Binding NovaSortidaCommand}" />
            </UniformGrid>

            <!-- Today's appointments -->
            <TextBlock Text="Cites d'avui" Style="{StaticResource Subtitol}" />
            <Border Style="{StaticResource TargetaDada}" Padding="0"
                    Visibility="{Binding CitesAvui, Converter={StaticResource ZeroAVisibilitatConverter}}">
                <DataGrid ItemsSource="{Binding CitesDelDia}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Durada" Binding="{Binding DuradaMin, StringFormat={}{0} min}" Width="80" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Client" Binding="{Binding NomMostrat}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Servei" Binding="{Binding Servei.Nom, TargetNullValue=Sense servei}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Treballadora" Binding="{Binding Treballadora.Nom, TargetNullValue=Sense assignar}" Width="*" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTextColumn Header="Estat" Binding="{Binding Estat}" Width="90" ElementStyle="{StaticResource CellaAmbTooltip}" />
                        <DataGridTemplateColumn Header="" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding Estat, Converter={StaticResource PendentAVisibilitatConverter}}">
                                        <Button Content="Realitzada" Style="{StaticResource BotoSecundari}"
                                                Padding="8,0" MinHeight="32"
                                                Command="{Binding DataContext.MarcarRealitzadaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Cancel·lada" Style="{StaticResource BotoSecundari}"
                                                Padding="8,0" MinHeight="32" Margin="6,0,0,0"
                                                Command="{Binding DataContext.MarcarCancelladaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="No assistida" Style="{StaticResource BotoSecundari}"
                                                Padding="8,0" MinHeight="32" Margin="6,0,0,0"
                                                Command="{Binding DataContext.MarcarNoAssistidaCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty state (pantalles 2.1) -->
            <Border Style="{StaticResource TargetaDada}"
                    Visibility="{Binding CitesAvui, Converter={StaticResource ZeroAVisibilitatInversaConverter}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="Avui no tens cap cita apuntada." Foreground="{StaticResource InkMutedBrush}"
                               Margin="0,0,0,12" />
                    <Button Content="+ Nova cita" Style="{StaticResource BotoPrimari}"
                            HorizontalAlignment="Center" Command="{Binding NovaCitaCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
