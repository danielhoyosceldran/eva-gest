<UserControl x:Class="EvaGest.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:el="clr-namespace:EvaGest.Views.Elements"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePad}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

            <!-- Quiet note: mostly that a background reload failed -->
            <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding Notice, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Style="{StaticResource DataLabel}" />
            </Border>

            <!-- A) Overview -->
            <TextBlock Text="{x:Static t:Texts.Overview}" Style="{StaticResource Subtitle}" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DataCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.SalesEvolution}" Style="{StaticResource DataLabel}" />
                        <ItemsControl ItemsSource="{Binding Evolution}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- One equal cell per month, packed to the left: on a
                                         narrow screen the bars get thinner instead of the
                                         latest months running off the card. -->
                                    <UniformGrid Rows="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="140" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel MaxWidth="{StaticResource ChartBarMaxWidth}" Margin="2,0" VerticalAlignment="Bottom">
                                        <Border Height="{Binding HeightDip}" Background="{StaticResource BlueBrush}"
                                                CornerRadius="2" VerticalAlignment="Bottom"
                                                ToolTip="{Binding AmountText}" />
                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HeroCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.ClientOfTheMonth}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding ClientOfTheMonthText}" Style="{StaticResource Subtitle}"
                                   TextWrapping="Wrap" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- B) Client rankings -->
            <TextBlock Text="{x:Static t:Texts.ClientRankings}" Style="{StaticResource Subtitle}" />
            <!-- Four across on a wide screen, wrapped onto two rows on a narrow one -->
            <el:WrappingUniformGrid MinItemWidth="{StaticResource RankingCardMinWidth}" Margin="0,0,0,8">
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.MostVisits}" Style="{StaticResource DataLabel}" />
                        <ItemsControl ItemsSource="{Binding TopVisits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding Client.Name, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Visits, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding TotalText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.MostSpend}" Style="{StaticResource DataLabel}" />
                        <ItemsControl ItemsSource="{Binding TopSpend}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding Client.Name, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding TotalText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.HighestAverage}" Style="{StaticResource DataLabel}" />
                        <ItemsControl ItemsSource="{Binding TopAverage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding Client.Name, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding AverageText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.NotSeenInAWhile}" Style="{StaticResource DataLabel}" />
                        <ItemsControl ItemsSource="{Binding NotSeenRecently}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding Client.Name, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding DaysSince, Mode=OneWay}" />
                                        <Run Text="{x:Static t:Texts.DaysSuffix}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding LastText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </el:WrappingUniformGrid>

            <!-- C) Worker ranking -->
            <TextBlock Text="{x:Static t:Texts.WorkerRanking}" Style="{StaticResource Subtitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <DatePicker SelectedDate="{Binding From, Converter={StaticResource DateOnlyConverter}}" FontSize="{StaticResource FontSizeInput}" />
                <TextBlock Text=" – " VerticalAlignment="Center" Margin="8,0" />
                <DatePicker SelectedDate="{Binding To, Converter={StaticResource DateOnlyConverter}}" FontSize="{StaticResource FontSizeInput}" />
                <Button Content="{x:Static t:Texts.ThisMonth}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectThisMonthCommand}" Margin="12,0,0,0" />
            </StackPanel>
            <Border Style="{StaticResource DataCard}" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding WorkerRanking}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource RowHeight}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static t:Texts.Name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellWithTooltip}" />
                        <DataGridTextColumn Header="{x:Static t:Texts.SalesHandled}" Binding="{Binding SalesHandled}" Width="140" ElementStyle="{StaticResource CellWithTooltip}" />
                        <DataGridTextColumn Header="{x:Static t:Texts.IncomeColumn}" Binding="{Binding IncomeText}" Width="110" ElementStyle="{StaticResource CellWithTooltip}" />
                        <DataGridTextColumn Header="{x:Static t:Texts.WorkPercentColumn}" Binding="{Binding WorkPercentText}" Width="110" ElementStyle="{StaticResource CellWithTooltip}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
