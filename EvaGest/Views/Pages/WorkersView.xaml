<UserControl x:Class="EvaGest.Views.Pages.WorkersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePad}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <Button Grid.Column="1" Content="{x:Static t:Texts.NewWorkerButton}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewWorkerCommand}" VerticalAlignment="Top" Cursor="" />
            </Grid>

            <!-- Quiet note: says when a delete became a deactivation because she already
                 has appointments or sales (RF-10) -->
            <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding Notice, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Style="{StaticResource DataLabel}" />
            </Border>

            <!-- Empty state: a bare table would not say what to do next (pantalles 1) -->
            <Border Style="{StaticResource DataCard}"
                    Visibility="{Binding HasNone, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{x:Static t:Texts.NoWorkersYet}"
                               Style="{StaticResource DataLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static t:Texts.NoWorkersYetDetail}"
                               Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Button Content="{x:Static t:Texts.NewWorkerButton}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Command="{Binding NewWorkerCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DataCard}" Padding="0" Margin="0,0,0,16"
                    Visibility="{Binding HasNone, Converter={StaticResource InverseVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource RowHeight}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static t:Texts.Name}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{Binding Worker.Color}" />
                                        <TextBlock Text="{Binding Worker.Name}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Worker.Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static t:Texts.Schedule}" Binding="{Binding ScheduleSummary}" Width="2*" ElementStyle="{StaticResource CellWithTooltip}" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Status}" Binding="{Binding StatusText}" Width="90" ElementStyle="{StaticResource CellWithTooltip}" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{x:Static t:Texts.Edit}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,0" MinHeight="32"
                                                Command="{Binding DataContext.EditWorkerCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Worker}" />
                                        <Button Content="{Binding StatusActionText}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ChangeStatusCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Worker}" />
                                        <Button Content="{x:Static t:Texts.Delete}" Style="{StaticResource DestructiveButton}"
                                                Padding="10,0" MinHeight="32" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteWorkerCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Worker}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Weekly overview: who covers which day, at a glance -->
            <StackPanel Visibility="{Binding HasNone, Converter={StaticResource InverseVisibilityConverter}}">
                <TextBlock Text="{x:Static t:Texts.WeeklySchedule}" Style="{StaticResource Subtitle}" />
                <Border Style="{StaticResource DataCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding DayNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center"
                                                   Style="{StaticResource DataLabel}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Worker.Name}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource FontUi}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{StaticResource InkBrush}" />

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- The tooltip carries the actual hours: colour alone
                                                         never has to be the only source of information -->
                                                    <Border Height="24" Margin="2,0" CornerRadius="3"
                                                            Background="{Binding Hex}"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding Detail}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
