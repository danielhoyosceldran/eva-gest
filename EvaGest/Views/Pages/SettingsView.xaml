<UserControl x:Class="EvaGest.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:elements="clr-namespace:EvaGest.Views.Elements"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PagePad}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <TextBlock Text="{x:Static t:Texts.Language}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.LanguageHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                          HorizontalAlignment="Left" MinWidth="220"
                          FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding LanguageConfirmation}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource InkMutedBrush}"
                           Visibility="{Binding LanguageConfirmation, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.ShopDetails}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.Name}" Style="{StaticResource DataLabel}" />
                <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />

                <TextBlock Text="{x:Static t:Texts.Address}" Style="{StaticResource DataLabel}" />
                <TextBox Text="{Binding ShopAddress, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />

                <TextBlock Text="{x:Static t:Texts.Phone}" Style="{StaticResource DataLabel}" />
                <TextBox Text="{Binding ShopPhone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" MaxWidth="220" HorizontalAlignment="Left" MinWidth="200" />

                <TextBlock Text="{Binding ErrorShop}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding ErrorShop, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static t:Texts.SaveDataButton}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveShopDetailsCommand}" />
                    <TextBlock Text="{Binding ShopConfirmation}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource InkMutedBrush}"
                               Visibility="{Binding ShopConfirmation, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.Vat}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.DefaultPercent}" Style="{StaticResource DataLabel}" />
                <TextBlock Text="{x:Static t:Texts.DefaultVatHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox Text="{Binding DefaultVatText, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" TextAlignment="Center" />
                    <Button Content="{x:Static t:Texts.SaveAlt}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding SaveDefaultVatCommand}" />
                </StackPanel>

                <TextBlock Text="{x:Static t:Texts.CalculationMode}" Style="{StaticResource DataLabel}" />
                <ComboBox ItemsSource="{Binding ModesVat}" SelectedItem="{Binding ModeVat}"
                          HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,6"
                          FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding VatModeExplanation}" Style="{StaticResource DataLabel}"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <CheckBox IsChecked="{Binding ApplyVatToTill}"
                          Content="{x:Static t:Texts.SplitVatOnMovements}" Margin="0,0,0,4" />
                <TextBlock Text="{x:Static t:Texts.SplitVatOnMovementsHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" />

                <TextBlock Text="{Binding VatError}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding VatError, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding VatConfirmation}" Foreground="{StaticResource InkMutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding VatConfirmation, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.OpeningHours}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.OpeningHoursHint}"
                           Style="{StaticResource DataLabel}" Margin="0,0,0,12" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding ScheduleDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <elements:ScheduleRowView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ScheduleError}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ScheduleError, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding ScheduleConfirmation}" Foreground="{StaticResource InkMutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ScheduleConfirmation, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{x:Static t:Texts.SaveScheduleButton}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveScheduleCommand}" />
                    <Button Content="{x:Static t:Texts.CopyMondayToWeekdays}" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,0,0" Command="{Binding ApplyMondayToRestCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.ClosedDays}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.ClosedDaysHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <DatePicker SelectedDate="{Binding NewClosedDate, Converter={StaticResource DateOnlyConverter}}"
                                Width="150" />
                    <TextBox Text="{Binding NewClosedReason, UpdateSourceTrigger=PropertyChanged}"
                             Width="240" Margin="12,0,0,0" />
                    <Button Content="{x:Static t:Texts.MarkClosedButton}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding AddClosedDayCommand}" />
                </StackPanel>

                <TextBlock Text="{x:Static t:Texts.NoClosedDaysYet}"
                           Style="{StaticResource DataLabel}"
                           Visibility="{Binding HasNoClosedDays, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{Binding ClosedDays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontFamily="{StaticResource FontUi}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Reason}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           FontFamily="{StaticResource FontUi}"
                                           FontSize="{StaticResource FontSizeBody}" />
                                <Button Grid.Column="2" Content="{x:Static t:Texts.Remove}" Style="{StaticResource SecondaryButton}"
                                        Padding="10,0" MinHeight="32"
                                        Command="{Binding DataContext.RemoveClosedDayCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.NavAgenda}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.SlotSizeHint}"
                           Style="{StaticResource DataLabel}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding SlotMinutesOptions}" SelectedItem="{Binding SlotMinutes}"
                          HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,16"
                          FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource FieldHeight}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={x:Static t:Texts.SlotMinutesOption}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{x:Static t:Texts.DefaultAppointmentDuration}" Style="{StaticResource DataLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox Text="{Binding DefaultAppointmentDurationText, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" TextAlignment="Center" />
                    <Button Content="{x:Static t:Texts.SaveAlt}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding SaveDefaultDurationCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorAgenda}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ErrorAgenda, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.Backups}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource DataLabel}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="{x:Static t:Texts.BackupHour}" Style="{StaticResource DataLabel}" />
                        <TextBox Text="{Binding BackupTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90" TextAlignment="Center" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Static t:Texts.BackupsToKeep}" Style="{StaticResource DataLabel}" />
                        <TextBox Text="{Binding BackupsToKeepText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90" TextAlignment="Center" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Static t:Texts.BackupHourHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ErrorBackup}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding ErrorBackup, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static t:Texts.SaveOptionsButton}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveBackupOptionsCommand}" />
                    <Button Content="{x:Static t:Texts.BackupNowButton}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                            Command="{Binding BackupNowCommand}" />
                    <Button Content="{x:Static t:Texts.RestoreBackupButton}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Command="{Binding RestoreBackupCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.NoticesAndSounds}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}" Margin="0,0,0,16">
            <StackPanel>
                <CheckBox IsChecked="{Binding ShowGuestNotice}"
                          Content="{x:Static t:Texts.GuestNoticeOption}" Margin="0,0,0,4" />
                <TextBlock Text="{x:Static t:Texts.GuestNoticeHint}"
                           Style="{StaticResource DataLabel}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <CheckBox IsChecked="{Binding ConfirmationSound}"
                          Content="{x:Static t:Texts.ConfirmationSoundOption}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static t:Texts.AccountantExport}" Style="{StaticResource Subtitle}" />
        <Border Style="{StaticResource DataCard}">
            <StackPanel>
                <TextBlock Text="{x:Static t:Texts.AccountantExportHint}"
                           Style="{StaticResource DataLabel}" Margin="0,0,0,12" TextWrapping="Wrap" />
                <Button Content="{x:Static t:Texts.ExportPeriod}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Command="{Binding ExportDataCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
