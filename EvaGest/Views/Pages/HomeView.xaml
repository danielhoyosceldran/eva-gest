<UserControl x:Class="EvaGest.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             Background="{StaticResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePad}">
            <TextBlock Text="{Binding DateText}" Style="{StaticResource PageTitle}" />

            <!-- Birthday alert: only visible when someone actually has one today -->
            <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding BirthdayNoticeText, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding BirthdayNoticeText}" TextWrapping="Wrap" />
            </Border>

            <!-- Transient note, e.g. a blocked reset (pantalles 2.1) -->
            <Border Background="{StaticResource NoticeBgBrush}" BorderBrush="{StaticResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding Notice, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Style="{StaticResource DataLabel}" />
            </Border>

            <!-- Summary cards -->
            <UniformGrid Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.AppointmentsToday}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding TodayAppointments}" Style="{StaticResource Figure}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.SalesToday}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding TodaySales}" Style="{StaticResource Figure}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.ChargedToday}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding ChargedTodayText}" Style="{StaticResource Figure}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.CashInPlural}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding CashInText}" Style="{StaticResource Figure}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DataCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.CashOutPlural}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding CashOutText}" Style="{StaticResource Figure}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HeroCard}">
                    <StackPanel>
                        <TextBlock Text="{x:Static t:Texts.DayBalance}" Style="{StaticResource DataLabel}" />
                        <TextBlock Text="{Binding BalanceText}" Style="{StaticResource HeroFigure}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick actions -->
            <UniformGrid Columns="5" Margin="0,0,0,20">
                <Button Content="{x:Static t:Texts.NewAppointmentTitle}" Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding NewAppointmentCommand}" />
                <Button Content="{x:Static t:Texts.NewSaleTitle}" Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding NewSaleCommand}" />
                <Button Content="{x:Static t:Texts.NewClientTitle}" Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding NewClientCommand}" />
                <Button Content="{x:Static t:Texts.CashIn}" Style="{StaticResource QuickActionButton}" Margin="0,0,8,0" Command="{Binding NewCashInCommand}" />
                <Button Content="{x:Static t:Texts.CashOut}" Style="{StaticResource QuickActionButton}" Command="{Binding NewCashOutCommand}" />
            </UniformGrid>

            <!-- Today's appointments -->
            <TextBlock Text="{x:Static t:Texts.TodayAppointments}" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource DataCard}" Padding="0"
                    Visibility="{Binding TodayAppointments, Converter={StaticResource ZeroToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding DayAppointments}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource RowHeight}"
                          Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static t:Texts.Time}" Binding="{Binding Time}" Width="*" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Duration}" Binding="{Binding DurationMin, StringFormat={}{0} min}" Width="*" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Client}" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Service}" Binding="{Binding Service.Name, TargetNullValue={x:Static t:Texts.NoService}}" Width="*" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Worker}" Binding="{Binding Worker.Name, TargetNullValue={x:Static t:Texts.Unassigned}}" Width="*" />
                        <DataGridTextColumn Header="{x:Static t:Texts.Status}" Binding="{Binding Status}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding Status, Converter={StaticResource PendingToVisibilityConverter}}">
                                            <Button Content="{x:Static t:Texts.Completed}" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,0" MinHeight="32"
                                                    Command="{Binding DataContext.MarkCompletedCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{x:Static t:Texts.Cancelled}" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,0" MinHeight="32" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.MarkCancelledCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{x:Static t:Texts.NoShow}" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,0" MinHeight="32" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.MarkNoShowCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding Status, Converter={StaticResource PendingToVisibilityInverseConverter}}">
                                            <Button Content="{x:Static t:Texts.BackToPending}" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,0" MinHeight="32"
                                                    Command="{Binding DataContext.MarkPendingCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty state (pantalles 2.1) -->
            <Border Style="{StaticResource DataCard}"
                    Visibility="{Binding TodayAppointments, Converter={StaticResource ZeroToVisibilityInverseConverter}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="{x:Static t:Texts.NoAppointmentsToday}" Foreground="{StaticResource InkMutedBrush}"
                               Margin="0,0,0,12" />
                    <Button Content="{x:Static t:Texts.NewAppointmentButton}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Command="{Binding NewAppointmentCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
