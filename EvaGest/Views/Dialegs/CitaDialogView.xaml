<UserControl x:Class="EvaGest.Views.Dialegs.CitaDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="420">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource Subtitol}" Margin="0,0,0,16" />

        <TextBlock Text="Client registrat (opcional si escrius un nom)" Style="{StaticResource EtiquetaDada}" />
        <ComboBox ItemsSource="{Binding ClientsActius}" SelectedItem="{Binding ClientSeleccionat}"
                  DisplayMemberPath="Nom" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}" />

        <TextBlock Text="Nom del convidat (si no és client registrat)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding TextClient, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Telèfon del convidat (opcional)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding TelefonConvidat, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data" Style="{StaticResource EtiquetaDada}" />
                <DatePicker SelectedDate="{Binding Data}" FontSize="{StaticResource FontSizeInput}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hora" Style="{StaticResource EtiquetaDada}" />
                <TextBox Text="{Binding Hora, StringFormat=HH\\:mm}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Durada (minuts)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding DuradaMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Servei (opcional)" Style="{StaticResource EtiquetaDada}" />
        <ComboBox ItemsSource="{Binding ServeisActius}" SelectedItem="{Binding Servei}"
                  DisplayMemberPath="Nom" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}" />

        <TextBlock Text="Treballadora (opcional)" Style="{StaticResource EtiquetaDada}" />
        <ComboBox ItemsSource="{Binding TreballadoresActives}" SelectedItem="{Binding Treballadora}"
                  DisplayMemberPath="Nom" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}" />

        <TextBlock Text="Observacions (opcional)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding Observacions, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="0,0,0,12" />

        <!-- Non-blocking inline warnings (pantalles 3.1) -->
        <StackPanel Margin="0,0,0,12">
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,0,0,6"
                    Visibility="{Binding AvisSolapament, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Possible solapament: no queda capacitat en aquesta franja." TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10" Margin="0,0,0,6"
                    Visibility="{Binding AvisForaHorari, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="L'hora cau fora de l'horari de la barberia." TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource AvisBgBrush}" BorderBrush="{StaticResource AvisBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiControl}" Padding="10"
                    Visibility="{Binding AvisDiaTancat, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding MotiuDiaTancat, StringFormat=Dia tancat: {0}}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding ErrorValidacio}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidacio, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel·lar" Style="{StaticResource BotoSecundari}"
                    Command="{Binding CancellarCommand}" IsCancel="True" />
            <Button Content="Guardar" Style="{StaticResource BotoPrimari}"
                    Command="{Binding GuardarCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
