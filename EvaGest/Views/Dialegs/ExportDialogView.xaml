<UserControl x:Class="EvaGest.Views.Dialegs.ExportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="360">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource Subtitol}" Margin="0,0,0,16" />

        <TextBlock Text="Des de" Style="{StaticResource EtiquetaDada}" />
        <DatePicker SelectedDate="{Binding Des}" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" />

        <TextBlock Text="Fins a" Style="{StaticResource EtiquetaDada}" />
        <DatePicker SelectedDate="{Binding Fins}" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" />

        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                   Text="Es generaran dos fitxers: el llistat de vendes i el desglossament d'IVA per a la gestoria." />

        <TextBlock Text="{Binding ErrorValidacio}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidacio, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel·lar" Style="{StaticResource BotoSecundari}" Command="{Binding CancellarCommand}" IsCancel="True" />
            <Button Content="Exportar" Style="{StaticResource BotoPrimari}" Command="{Binding ExportarCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
