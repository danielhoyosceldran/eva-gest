<UserControl x:Class="EvaGest.Views.Dialegs.AjudaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="480">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource Subtitol}" Margin="0,0,0,16" />

        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Preguntes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,8" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                  Padding="4">
                            <Expander.Header>
                                <TextBlock Text="{Binding Pregunta}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </Expander.Header>
                            <TextBlock Text="{Binding Resposta}" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkMutedBrush}" Margin="8,8,8,8" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Tancar" Style="{StaticResource BotoSecundari}" Command="{Binding TancarAjudaCommand}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
