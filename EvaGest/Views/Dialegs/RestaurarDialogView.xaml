<UserControl x:Class="EvaGest.Views.Dialegs.RestaurarDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="440">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource Subtitol}" Margin="0,0,0,16" />

        <Border Style="{StaticResource TargetaDada}" Padding="0" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Copies}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                      Background="{StaticResource SurfaceBrush}" BorderThickness="0" MaxHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat={}{0:dd/MM/yyyy}}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                    <DataGridTextColumn Header="Hora" Binding="{Binding Data, StringFormat={}{0:HH:mm}}" Width="70" ElementStyle="{StaticResource CellaAmbTooltip}" />
                    <DataGridTextColumn Header="Tipus" Binding="{Binding EsAutomatica, Converter={StaticResource TipusCopiaConverter}}" Width="100" ElementStyle="{StaticResource CellaAmbTooltip}" />
                    <DataGridTextColumn Header="Mida" Binding="{Binding BytesMida, Converter={StaticResource BytesAMidaConverter}}" Width="90" ElementStyle="{StaticResource CellaAmbTooltip}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Text="{Binding ErrorValidacio}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidacio, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel·lar" Style="{StaticResource BotoSecundari}" Command="{Binding CancellarCommand}" IsCancel="True" />
            <Button Content="Restaurar" Style="{StaticResource BotoDestructiu}" Command="{Binding RestaurarCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
