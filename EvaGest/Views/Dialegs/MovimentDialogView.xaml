<UserControl x:Class="EvaGest.Views.Dialegs.MovimentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="360">
        <TextBlock Text="{Binding Titol}" Style="{StaticResource Subtitol}" Margin="0,0,0,16" />

        <TextBlock Text="Import (€)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding PreuText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Mètode de pagament" Style="{StaticResource EtiquetaDada}" />
        <ComboBox ItemsSource="{Binding MetodesActius}" SelectedItem="{Binding Metode}"
                  DisplayMemberPath="Nom" Margin="0,0,0,12" FontSize="{StaticResource FontSizeInput}" MinHeight="{StaticResource AlcadaCamp}" />

        <TextBlock Text="Concepte" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding Concepte, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <CheckBox Content="Desglossar IVA" IsChecked="{Binding DesglossarIva}" Margin="0,0,0,12"
                  FontSize="{StaticResource FontSizeInput}" />

        <StackPanel Visibility="{Binding DesglossarIva, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Percentatge d'IVA" Style="{StaticResource EtiquetaDada}" />
            <TextBox Text="{Binding IvaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
        </StackPanel>

        <TextBlock Text="Observacions (opcional)" Style="{StaticResource EtiquetaDada}" />
        <TextBox Text="{Binding Observacions, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorValidacio}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding ErrorValidacio, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel·lar" Style="{StaticResource BotoSecundari}" Command="{Binding CancellarCommand}" IsCancel="True" />
            <Button Content="Guardar" Style="{StaticResource BotoPrimari}" Command="{Binding GuardarCommand}" IsDefault="True" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
