<UserControl x:Class="EvaGest.Views.Dialegs.FitxaClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="480">
        <!-- Header -->
        <TextBlock Text="{Binding Client.Nom}" Style="{StaticResource TitolPagina}" Margin="0,0,0,4" />
        <TextBlock Text="Adormit" Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                   Visibility="{Binding Client.Adormit, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Contact data -->
        <TextBlock Style="{StaticResource EtiquetaDada}">
            <Run Text="Mòbil: " /><Run Text="{Binding Client.Mobil, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Style="{StaticResource EtiquetaDada}" Text="{Binding Client.Correu, StringFormat=Correu: {0}}"
                   Visibility="{Binding Client.Correu, Converter={StaticResource NullToVisibilityConverter}}" />

        <!-- Indicators -->
        <TextBlock Text="Indicadors" Style="{StaticResource Subtitol}" />
        <UniformGrid Columns="3" Rows="2">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Visites" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding Indicadors.Visites}" Style="{StaticResource Xifra}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Cancel·lades" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding Indicadors.Cancellades}" Style="{StaticResource Xifra}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="No assistides" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding Indicadors.NoAssistides}" Style="{StaticResource Xifra}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Total gastat" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding TotalGastatText}" Style="{StaticResource Xifra}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mitjana / visita" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding MitjanaText}" Style="{StaticResource Xifra}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Freqüència (dies)" Style="{StaticResource EtiquetaDada}" />
                <TextBlock Text="{Binding FrequenciaText}" Style="{StaticResource Xifra}" />
            </StackPanel>
        </UniformGrid>

        <!-- History -->
        <TextBlock Text="Historial" Style="{StaticResource Subtitol}" />
        <Border Style="{StaticResource TargetaDada}" Padding="0" MaxHeight="220">
            <DataGrid ItemsSource="{Binding Historial}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" RowHeight="{StaticResource AlcadaFila}"
                      Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="90" />
                    <DataGridTextColumn Header="Tipus" Binding="{Binding Tipus}" Width="70" />
                    <DataGridTextColumn Header="Concepte" Binding="{Binding Concepte}" Width="*" />
                    <DataGridTextColumn Header="Estat" Binding="{Binding Estat}" Width="100" />
                    <DataGridTextColumn Header="Import" Binding="{Binding Import}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Tancar" Style="{StaticResource BotoSecundari}" Command="{Binding TancarFitxaCommand}" />
            <Button Style="{StaticResource BotoSecundari}" Margin="12,0,0,0"
                    Command="{Binding AdormirDespertarCommand}"
                    Content="{Binding AdormirDespertarText}" />
            <Button Content="Eliminar" Style="{StaticResource BotoDestructiu}" Command="{Binding EliminarCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
