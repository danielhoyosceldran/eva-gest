<UserControl x:Class="EvaGest.Views.Elements.SearchPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <!-- A search box with a dropdown of matches, plus the whole list in a dialog: the
         same box as the client picker's "existing client" half, for any long list. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Box" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"
                 Tag="{Binding Placeholder}" Binding.TargetUpdated="OnTextWrittenByCode">
            <!-- Enter and Escape are only taken while the list is open (their commands are
                 disabled otherwise), so with it closed they still reach the dialog's
                 default and cancel buttons. -->
            <TextBox.InputBindings>
                <KeyBinding Key="Down" Command="{Binding MoveDownCommand}" />
                <KeyBinding Key="Up" Command="{Binding MoveUpCommand}" />
                <KeyBinding Key="Enter" Command="{Binding PickHighlightedCommand}" />
                <KeyBinding Key="Escape" Command="{Binding CloseDropdownCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <!-- "Veure la llista" in a form; just "…" (same tooltip) where the box sits in a
             narrow filter cell or toolbar. The code-behind switches it on Compact. -->
        <Button x:Name="BrowseButton" Grid.Column="1" Content="{x:Static t:Texts.BrowseList}"
                Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}"
                Margin="8,0,0,0" MinHeight="{StaticResource FieldHeight}" />

        <!-- StaysOpen=False closes the list on any click elsewhere and writes that back
             to IsDropdownOpen. The list never takes keyboard focus, so typing carries on
             in the box while the arrows move the highlight. -->
        <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Box}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                    MinWidth="{Binding ActualWidth, ElementName=Box}">
                <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding Highlighted, Mode=TwoWay}"
                         Focusable="False" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClientRowItem}">
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole row is the click target, hence the transparent
                                 background: without one the gaps would not hit-test. -->
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OptionRow}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
