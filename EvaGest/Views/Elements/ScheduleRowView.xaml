<UserControl x:Class="EvaGest.Views.Elements.ScheduleRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:el="clr-namespace:EvaGest.Views.Elements">
    <!--
      One day of the weekly schedule, shared by the barbershop's opening hours and the
      worker dialog so both forms behave identically. Morning and afternoon are ticked
      separately; each hour is a TimeBox (hours and minutes, the ":" fixed).
    -->
    <UserControl.Resources>
        <Style x:Key="TimeSelector" TargetType="el:TimeBox">
            <Setter Property="Width" Value="86" />
        </Style>

        <Style x:Key="IntervalSeparator" TargetType="TextBlock">
            <Setter Property="Text" Value="–" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding DayName}" VerticalAlignment="Center"
                       FontFamily="{StaticResource FontUi}"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource InkBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                <CheckBox Content="{x:Static t:Texts.Morning}" IsChecked="{Binding WorksMorning}"
                          VerticalAlignment="Center" Width="76" />
                <el:TimeBox Style="{StaticResource TimeSelector}" IsEnabled="{Binding WorksMorning}" Time="{Binding MorningStart}" />
                <TextBlock Style="{StaticResource IntervalSeparator}" />
                <el:TimeBox Style="{StaticResource TimeSelector}" IsEnabled="{Binding WorksMorning}" Time="{Binding MorningEnd}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox Content="{x:Static t:Texts.Afternoon}" IsChecked="{Binding WorksAfternoon}"
                          VerticalAlignment="Center" Width="76" />
                <el:TimeBox Style="{StaticResource TimeSelector}" IsEnabled="{Binding WorksAfternoon}" Time="{Binding AfternoonStart}" />
                <TextBlock Style="{StaticResource IntervalSeparator}" />
                <el:TimeBox Style="{StaticResource TimeSelector}" IsEnabled="{Binding WorksAfternoon}" Time="{Binding AfternoonEnd}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                   FontSize="{StaticResource FontSizeSmall}" Margin="110,2,0,4"
                   TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
