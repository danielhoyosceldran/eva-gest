<UserControl x:Class="EvaGest.Views.Elements.ScheduleRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources">
    <!--
      One day of the weekly schedule, shared by the barbershop's opening hours and the
      worker dialog so both forms behave identically. Morning and afternoon are ticked
      separately; each hour is a drop-down of quarter hours that stays typeable.
    -->
    <UserControl.Resources>
        <Style x:Key="TimeSelector" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="Width" Value="86" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="MinHeight" Value="{StaticResource FieldHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeInput}" />
        </Style>

        <Style x:Key="IntervalSeparator" TargetType="TextBlock">
            <Setter Property="Text" Value="–" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding DayName}" VerticalAlignment="Center"
                       FontFamily="{StaticResource FontUi}"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource InkBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                <CheckBox Content="{x:Static t:Texts.Morning}" IsChecked="{Binding WorksMorning}"
                          VerticalAlignment="Center" Width="76" />
                <ComboBox Style="{StaticResource TimeSelector}"
                          ItemsSource="{Binding AvailableTimes}"
                          IsEnabled="{Binding WorksMorning}"
                          Text="{Binding MorningStart, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource IntervalSeparator}" />
                <ComboBox Style="{StaticResource TimeSelector}"
                          ItemsSource="{Binding AvailableTimes}"
                          IsEnabled="{Binding WorksMorning}"
                          Text="{Binding MorningEnd, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <CheckBox Content="{x:Static t:Texts.Afternoon}" IsChecked="{Binding WorksAfternoon}"
                          VerticalAlignment="Center" Width="76" />
                <ComboBox Style="{StaticResource TimeSelector}"
                          ItemsSource="{Binding AvailableTimes}"
                          IsEnabled="{Binding WorksAfternoon}"
                          Text="{Binding AfternoonStart, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource IntervalSeparator}" />
                <ComboBox Style="{StaticResource TimeSelector}"
                          ItemsSource="{Binding AvailableTimes}"
                          IsEnabled="{Binding WorksAfternoon}"
                          Text="{Binding AfternoonEnd, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                   FontSize="{StaticResource FontSizeSmall}" Margin="110,2,0,4"
                   TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
