<UserControl x:Class="EvaGest.Views.Elements.GraellaSetmanaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:EvaGest.Helpers"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="True" KeyDown="AlPremerTecla">
    <UserControl.Resources>
        <!-- Whole-column background rules: two tiled brushes instead of one element per
             slot. A week is 7 x ~40 slots, and 280 hit-testable elements is exactly what
             makes these grids feel sluggish. Their tile heights are set in code-behind
             from AlcadaSlotPx / AlcadaHoraPx, so the rules follow the configured
             granularity; they are deliberately left unfrozen for that reason. -->
        <DrawingBrush x:Key="LiniesFranja" TileMode="Tile" Stretch="None"
                      ViewportUnits="Absolute" Viewport="0,0,8,44"
                      AlignmentX="Left" AlignmentY="Top">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#66D5DBE1">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="LiniesHora" TileMode="Tile" Stretch="None"
                      ViewportUnits="Absolute" Viewport="0,0,8,88"
                      AlignmentX="Left" AlignmentY="Top">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource LineBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Empty corner above the hour ruler -->
        <Border Grid.Row="0" Grid.Column="0" Width="{Binding AmpladaReglaPx}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1" />

        <!-- Day headers live outside the ScrollViewer, which is all it takes to make
             them sticky. Their width tracks the body panel so the vertical scrollbar
             never pushes them out of alignment with the columns. -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <ItemsControl ItemsSource="{Binding Dies}" HorizontalAlignment="Left"
                          Width="{Binding ActualWidth, ElementName=PanelDies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CapcaleraDia}"
                                    ToolTip="{Binding CapcaleraCompleta}"
                                    Command="{Binding DataContext.ClicCapcaleraCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock x:Name="Dia" Text="{Binding CapcaleraDia}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource FontUi}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <TextBlock x:Name="Numero" Text="{Binding CapcaleraNumero}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource FontUi}"
                                               FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding MotiuTancat}" MaxWidth="120"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource FontUi}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Visibility="{Binding Tancat, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <!-- Today's rule, same 3px weight as the hero card's -->
                            <Border Grid.Row="1" Height="{StaticResource GruixRegla}"
                                    Background="{StaticResource BlauBrush}"
                                    Visibility="{Binding EsAvui, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EsAvui}" Value="True">
                                <Setter TargetName="Numero" Property="Foreground" Value="{StaticResource BlauBrush}" />
                                <Setter TargetName="Numero" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Dia" Property="Foreground" Value="{StaticResource BlauBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- The hour ruler scrolls with the body (its labels are content) and is sticky
             horizontally by construction, because the grid never scrolls sideways.
             That is why no ScrollChanged handler is needed anywhere here. -->
        <ScrollViewer x:Name="Desplacador" Grid.Row="1" Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- VerticalAlignment=Top is load-bearing: an element with an explicit
                     Height and the default Stretch alignment is CENTRED by WPF, so on any
                     week short enough to fit the window the ruler drifted down while the
                     day columns stayed anchored at the top. -->
                <Canvas Grid.Column="0" VerticalAlignment="Top"
                        Width="{Binding AmpladaReglaPx}" Height="{Binding AlcadaTotalPx}">
                    <ItemsControl ItemsSource="{Binding Hores}" Width="{Binding AmpladaReglaPx}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource EtiquetaRegla}"
                                           Margin="0,-8,8,0" HorizontalAlignment="Right"
                                           Width="{Binding DataContext.AmpladaReglaPx,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextAlignment="Right" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Now marker on the ruler edge -->
                    <Ellipse Width="7" Height="7" Fill="{StaticResource VermellPalBrush}"
                             Canvas.Left="{Binding AmpladaReglaPx}" Canvas.Top="{Binding AraTop}"
                             Margin="-5,-3.5,0,0"
                             Visibility="{Binding AraVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Canvas>

                <!-- Same height and anchoring as the ruler, so an appointment at 10:00 sits
                     exactly on the 10:00 line no matter how tall the window is. Without the
                     explicit height the columns stretched past closing time and drew rules
                     over empty space. -->
                <ItemsControl x:Name="PanelDies" Grid.Column="1" ItemsSource="{Binding Dies}"
                              VerticalAlignment="Top" Height="{Binding AlcadaTotalPx}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <!-- Today's column tint, behind everything -->
                                    <Border Background="#0A1E40AF"
                                            Visibility="{Binding EsAvui, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <Border Background="{StaticResource LiniesFranja}" />
                                    <Border Background="{StaticResource LiniesHora}" />

                                    <!-- Closed and out-of-hours bands. Never hit-testable:
                                         the app only warns about out-of-hours bookings,
                                         it never blocks them (casos-us CU-01). -->
                                    <ItemsControl ItemsSource="{Binding Bandes}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                <Setter Property="Canvas.Left" Value="0" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Banda" Background="{StaticResource NeutralBgBrush}"
                                                        Opacity="0.55" Height="{Binding Alcada}"
                                                        Width="{Binding ActualWidth,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tipus}" Value="DiaTancat">
                                                        <Setter TargetName="Banda" Property="Background"
                                                                Value="{StaticResource TramaDiaTancat}" />
                                                        <Setter TargetName="Banda" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Clickable empty space. Background MUST be Transparent:
                                         with a null background WPF does not hit-test it and
                                         every click on empty space is lost. -->
                                    <Canvas Background="Transparent" h:GraellaInteraccio.Dia="{Binding}">
                                        <Border Canvas.Left="0" Canvas.Top="{Binding SlotSobrevolatTop}"
                                                Height="{Binding SlotSobrevolatAlcada}"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                Background="#0F1E40AF" BorderBrush="{StaticResource BlauBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource RadiControl}"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding MostrarSobrevolat, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SlotSobrevolatText}" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource FontUi}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource BlauBrush}" />
                                        </Border>
                                    </Canvas>

                                    <ItemsControl ItemsSource="{Binding Cites}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                <Setter Property="Height" Value="{Binding Alcada}" />
                                                <Setter Property="Canvas.Left">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource PosicioCarrilConverter}"
                                                                      ConverterParameter="Esquerra">
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            <Binding Path="CarrilIndex" />
                                                            <Binding Path="NombreCarrils" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Width">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource PosicioCarrilConverter}"
                                                                      ConverterParameter="Amplada">
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            <Binding Path="CarrilIndex" />
                                                            <Binding Path="NombreCarrils" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CitaGraella}"
                                                        ToolTip="{Binding TextTooltip}"
                                                        Command="{Binding DataContext.ClicCitaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel VerticalAlignment="Top">
                                                        <TextBlock Style="{StaticResource TitolCita}"
                                                                   Visibility="{Binding MostrarTitol, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Run Text="{Binding HoraText, Mode=OneWay}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Titol, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Subtitol}" Style="{StaticResource SubtitolCita}"
                                                                   Visibility="{Binding MostrarSubtitol, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Now line, only on today's column -->
                                    <Canvas IsHitTestVisible="False"
                                            Visibility="{Binding EsAvui, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Height="1.5" Background="{StaticResource VermellPalBrush}"
                                                Canvas.Left="0"
                                                Canvas.Top="{Binding DataContext.AraTop, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                Visibility="{Binding DataContext.AraVisible,
                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                             Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
