<UserControl x:Class="EvaGest.Views.Elements.ClientPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:EvaGest.Resources"
             xmlns:h="clr-namespace:EvaGest.Helpers"
             xmlns:el="clr-namespace:EvaGest.Views.Elements">
    <StackPanel>
        <!-- Existing / new / no client. The modes keep their own text, so flipping the
             switch by mistake loses nothing. "No client" is only there for sales: the
             grid leaves collapsed children out, so the other two then share the row
             between them, and it wraps onto a second row rather than cut a label where
             the column is too narrow for three. The negative margin cancels the outer
             half of each button's 4 px side margin, leaving an 8 px gap between buttons
             only. The 8 px bottom margin of each button spaces the rows, and the field below. -->
        <el:WrappingUniformGrid MinItemWidth="{StaticResource ClientModeMinWidth}" Margin="-4,0,-4,0">
            <RadioButton Style="{StaticResource SegmentButton}" Margin="4,0,4,8"
                         Content="{x:Static t:Texts.ExistingClient}"
                         IsChecked="{Binding IsExistingClient, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource SegmentButton}" Margin="4,0,4,8"
                         Content="{x:Static t:Texts.NewClient}"
                         IsChecked="{Binding IsNewClient, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource SegmentButton}" Margin="4,0,4,8"
                         Content="{x:Static t:Texts.NoClient}"
                         IsChecked="{Binding IsNoClient, Mode=TwoWay}"
                         Visibility="{Binding AllowsNoClient, Converter={StaticResource BoolToVisibilityConverter}}" />
        </el:WrappingUniformGrid>

        <!-- Both rows share one grid cell and only one is visible: they are the same
             height, so swapping them never resizes the SizeToContent dialog. -->
        <Grid>
            <!-- Existing client: search box with a dropdown of matches, plus the whole list -->
            <Grid Visibility="{Binding IsExistingClient, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Arrows, Enter and Esc for the list; with it closed, Enter and Esc reach the dialog (B-32) -->
                <TextBox x:Name="Box" h:PickerKeys.Enabled="True" Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{x:Static t:Texts.ClientSearchPlaceholder}" />
                <Button Grid.Column="1" Content="{x:Static t:Texts.BrowseClients}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseCommand}" Margin="8,0,0,0" MinHeight="{StaticResource FieldHeight}" />
            </Grid>

            <!-- New client: just the name, saved as a guest -->
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{x:Static t:Texts.NewClientNamePlaceholder}"
                     Visibility="{Binding IsNewClient, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- No client: nothing to type, just a line saying so, as tall as the boxes -->
            <Border MinHeight="{StaticResource FieldHeight}"
                    Visibility="{Binding IsNoClient, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Static t:Texts.NoClientHint}" Foreground="{StaticResource InkMutedBrush}"
                           VerticalAlignment="Center" Margin="2,0,0,0" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Hidden rather than collapsed: the dialogs are SizeToContent, and a line that
             came and went would make the whole window jump on every pick. -->
        <TextBlock Text="{x:Static t:Texts.RegisteredClientTag}" FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource CompletedFgBrush}" Margin="2,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- StaysOpen=False closes the list on any click elsewhere and writes that back
             to IsDropdownOpen. The list never takes keyboard focus, so typing carries
             on in the box while the arrows move the highlight. -->
        <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Box}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                    MinWidth="{Binding ActualWidth, ElementName=Box}">
                <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding Highlighted, Mode=TwoWay}"
                         Focusable="False" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClientRowItem}">
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole row is the click target, hence the transparent
                                 background: without one the gaps would not hit-test. -->
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ClientRow}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
