<?xml version="1.0" encoding="utf-8"?>
<!--
  Delivery build (Fase 11). Self-contained on purpose: the barbershop's PC is not a
  machine anyone is going to install a .NET runtime on, and a missing runtime would
  surface as an error dialog on the very first launch.

  Usage:  dotnet publish EvaGest -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishDir>bin\Publish\win-x64\</PublishDir>

    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFramework>net9.0-windows</TargetFramework>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Trimming is off: EF Core resolves the model through reflection, and a trimmed
         build fails at the first query rather than at build time. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
